    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function renderQuizQuestionsBuilder() {
      const container = document.getElementById('quizQuestionsContainer');
      if (!container) return;

      container.innerHTML = '';

      currentQuizQuestions.forEach((q, qIdx) => {
        const qCard = document.createElement('div');
        qCard.className = 'quiz-question-card';
        qCard.id = `quiz-question-${qIdx}`;

        const isFirst = qIdx === 0;
        const isLast = qIdx === currentQuizQuestions.length - 1;

        qCard.innerHTML = `
          <div class="quiz-question-header">
            <div class="quiz-question-title">
              <span style="background: var(--sunset-accent); color:#FFF; font-size:0.75rem; padding:3px 8px; border-radius:6px;">Q${qIdx + 1}</span>
              <span>Question #${qIdx + 1}</span>
            </div>
            <div style="display: flex; gap: 6px; align-items: center;">
              <button type="button" class="btn-order-icon" onclick="moveQuestion(${qIdx}, -1)" ${isFirst ? 'disabled style="opacity:0.4; cursor:not-allowed;"' : ''} title="Move Up">▲</button>
              <button type="button" class="btn-order-icon" onclick="moveQuestion(${qIdx}, 1)" ${isLast ? 'disabled style="opacity:0.4; cursor:not-allowed;"' : ''} title="Move Down">▼</button>
              <button type="button" class="btn-card-action btn-card-delete" onclick="deleteQuestion(${qIdx})" ${currentQuizQuestions.length <= 1 ? 'disabled style="opacity:0.4; cursor:not-allowed;"' : ''}>
                🗑️ Delete Question
