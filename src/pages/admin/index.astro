        <!-- Outcome Result View (Shown at the end of the test) -->
        <div id="quizPreviewOutcomeView" style="display: none; text-align: center; padding: 20px 10px;">
          <span class="preview-category-badge" style="background: #FFE8D6; color: var(--sunset-accent);">✦ YOUR AURA ARCHETYPE RESULT</span>
