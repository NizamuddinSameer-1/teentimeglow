                </div>
                <div style="display: flex; gap: 8px; border-top: 1px solid #F3F4F6; padding-top: 10px;">
                  <button type="button" style="flex: 1; background: #D1FAE5; color: #065F46;" class="btn-card-action" onclick={`moderateFanUpload('${item.id}', 'approved')`}>✓ Approve</button>
                  <button type="button" style="flex: 1; background: #FEE2E2; color: #DC2626;" class="btn-card-action" onclick={`moderateFanUpload('${item.id}', 'rejected')`}>✕ Reject</button>
                </div>
              </div>
            </div>
          ))}
        </div>
