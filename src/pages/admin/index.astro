            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 14px; margin-bottom: 14px;">
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" style="font-size: 0.8rem;">Step Indicator Pill</label>
              <input type="text" class="form-input q-indicator-input" data-qidx="${qIdx}" value="${escapeHtml(q.indicator || `Step ${qIdx + 1}`)}" placeholder="e.g. Step 1: Morning Ritual" />
            </div>
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" style="font-size: 0.8rem;">Question Prompt / Headline *</label>
              <input type="text" class="form-input q-text-input" data-qidx="${qIdx}" required value="${escapeHtml(q.question_text || '')}" placeholder="e.g. What is your dream Saturday morning ritual?" />
            </div>
          </div>

          <!-- Options Container -->
          <div style="margin-top: 14px;">
            <label class="form-label" style="font-size: 0.82rem; margin-bottom: 8px;">
              Answer Options (${q.options.length}):
            </label>
            <div class="quiz-options-container" id="options-for-q-${qIdx}">
              ${q.options.map((opt, optIdx) => `
                <div class="quiz-option-row">
                  <div class="quiz-option-badge">Option ${optIdx + 1}</div>
                  <div>
                    <input
                      type="text"
                      class="form-input opt-text-input"
                      data-qidx="${qIdx}"
                      data-optidx="${optIdx}"
                      required
                      value="${escapeHtml(opt.option_text || '')}"
                      placeholder="e.g. Option ${optIdx + 1} text..."
                    />
                  </div>
                  <div>
                    <select class="form-select opt-archetype-select" data-qidx="${qIdx}" data-optidx="${optIdx}">
                      <option value="sunset_muse" ${opt.outcome_key === 'sunset_muse' ? 'selected' : ''}>Sunset Muse ✨</option>
                      <option value="clean_girl" ${opt.outcome_key === 'clean_girl' ? 'selected' : ''}>Clean Girl Dew 🍵</option>
                      <option value="cozy_vanilla" ${opt.outcome_key === 'cozy_vanilla' ? 'selected' : ''}>Vanilla Warmth 🍦</option>
                      <option value="downtown" ${opt.outcome_key === 'downtown' ? 'selected' : ''}>Downtown Indie 🎸</option>
                    </select>
                  </div>
                  <div>
                    <button
                      type="button"
                      class="btn-card-action btn-card-delete"
                      onclick="removeOption(${qIdx}, ${optIdx})"
                      ${q.options.length <= 2 ? 'disabled style="opacity:0.4; cursor:not-allowed;"' : ''}
                      title="Remove option"
                    >
                      ✕
                    </button>
                  </div>
                </div>
              `).join('')}
            </div>

            <button type="button" class="btn-add-option" onclick="addOption(${qIdx})">
              <span>➕ Add Option ${q.options.length + 1}</span>
            </button>
          </div>
        `;

        container.appendChild(qCard);
      });
    }

    function syncQuizQuestionsFromDOM() {
      currentQuizQuestions.forEach((q, qIdx) => {
        const indInput = document.querySelector(`.q-indicator-input[data-qidx="${qIdx}"]`);
        const textInput = document.querySelector(`.q-text-input[data-qidx="${qIdx}"]`);
        if (indInput) q.indicator = indInput.value;
        if (textInput) q.question_text = textInput.value;

        q.options.forEach((opt, optIdx) => {
          const optInput = document.querySelector(`.opt-text-input[data-qidx="${qIdx}"][data-optidx="${optIdx}"]`);
          const sel = document.querySelector(`.opt-archetype-select[data-qidx="${qIdx}"][data-optidx="${optIdx}"]`);
          if (optInput) opt.option_text = optInput.value;
          if (sel) opt.outcome_key = sel.value;
        });
      });
    }

    function addQuestion() {
      syncQuizQuestionsFromDOM();
      const nextNum = currentQuizQuestions.length + 1;
      currentQuizQuestions.push({
        indicator: `Step ${nextNum}`,
        question_text: '',
        image_url: '',
        options: [
          { option_text: '', outcome_key: 'sunset_muse', image_url: '' },
          { option_text: '', outcome_key: 'clean_girl', image_url: '' },
          { option_text: '', outcome_key: 'cozy_vanilla', image_url: '' },
          { option_text: '', outcome_key: 'downtown', image_url: '' }
        ]
      });
      renderQuizQuestionsBuilder();
    }

    function deleteQuestion(qIdx) {
      if (currentQuizQuestions.length <= 1) {
        alert('A quiz must have at least 1 question.');
        return;
      }
      syncQuizQuestionsFromDOM();
      currentQuizQuestions.splice(qIdx, 1);
      renderQuizQuestionsBuilder();
    }

    function moveQuestion(qIdx, dir) {
      const targetIdx = qIdx + dir;
      if (targetIdx < 0 || targetIdx >= currentQuizQuestions.length) return;
      syncQuizQuestionsFromDOM();
      const temp = currentQuizQuestions[qIdx];
      currentQuizQuestions[qIdx] = currentQuizQuestions[targetIdx];
      currentQuizQuestions[targetIdx] = temp;
      renderQuizQuestionsBuilder();
    }

    function addOption(qIdx) {
      syncQuizQuestionsFromDOM();
      const q = currentQuizQuestions[qIdx];
      if (!q) return;
      const archetypeKeys = ['sunset_muse', 'clean_girl', 'cozy_vanilla', 'downtown'];
      const nextArchetype = archetypeKeys[q.options.length % archetypeKeys.length];
      q.options.push({
        option_text: '',
        outcome_key: nextArchetype,
        image_url: ''
      });
      renderQuizQuestionsBuilder();
    }

    function removeOption(qIdx, optIdx) {
      const q = currentQuizQuestions[qIdx];
      if (!q) return;
      if (q.options.length <= 2) {
        alert('Each question must have at least 2 options.');
        return;
      }
      syncQuizQuestionsFromDOM();
      q.options.splice(optIdx, 1);
      renderQuizQuestionsBuilder();
    }

    function handleQuizCoverUpload(e) {
      const file = e.target.files?.[0];
      if (file) uploadPhotoFile(file, 'quizCoverPreview', 'quizCoverUrl', 'quizCoverUploadText');
    }

    async function handleSaveQuiz(e) {
      e.preventDefault();
      syncQuizQuestionsFromDOM();

      const editId = document.getElementById('editQuizId').value;
      const title = document.getElementById('quizTitle').value.trim();
      const description = document.getElementById('quizDescription').value.trim();
      const cover_image_url = document.getElementById('quizCoverUrl').value.trim();
      const is_active = document.getElementById('quizIsActive').checked;

      if (!title) {
        alert('Please enter a quiz title');
        return;
      }

      if (currentQuizQuestions.length === 0) {
        alert('Please add at least 1 question to your quiz');
        return;
      }

      for (let i = 0; i < currentQuizQuestions.length; i++) {
        const q = currentQuizQuestions[i];
        if (!q.question_text || !q.question_text.trim()) {
          alert(`Question #${i + 1} needs question prompt text.`);
          return;
        }
        if (!q.options || q.options.length < 2) {
          alert(`Question #${i + 1} needs at least 2 options.`);
          return;
        }
        for (let j = 0; j < q.options.length; j++) {
          if (!q.options[j].option_text || !q.options[j].option_text.trim()) {
            alert(`Question #${i + 1}, Option #${j + 1} text cannot be empty.`);
            return;
          }
        }
      }

      const submitBtn = document.getElementById('btnSaveQuiz');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Saving Quiz... ⏳';

      try {
        const payload = {
          id: editId || undefined,
          title,
          description,
          cover_image_url,
          is_active,
          questions: currentQuizQuestions
        };

        const res = await fetch('/api/admin/quizzes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await parseApiResponse(res);

        if (data.success) {
          showToast(editId ? '🔮 Quiz updated successfully!' : '✨ New quiz created & published!');
          setTimeout(() => window.location.reload(), 1200);
        } else {
          alert('Error saving quiz: ' + (data.error || 'Unknown error'));
          submitBtn.disabled = false;
          submitBtn.textContent = '✨ Save & Publish Quiz';
        }
      } catch (err) {
        alert('Save error: ' + err.message);
        submitBtn.disabled = false;
        submitBtn.textContent = '✨ Save & Publish Quiz';
      }
    }

    function editQuiz(quiz) {
      document.getElementById('editQuizId').value = quiz.id;
      document.getElementById('quizTitle').value = quiz.title;
      document.getElementById('quizDescription').value = quiz.description || '';
      document.getElementById('quizCoverUrl').value = quiz.cover_image_url || '/assets/arrival-1.jpg';
      const preview = document.getElementById('quizCoverPreview');
      if (preview) {
        preview.src = quiz.cover_image_url || '/assets/arrival-1.jpg';
        preview.style.display = 'block';
      }
      document.getElementById('quizIsActive').checked = Boolean(quiz.is_active);

      if (Array.isArray(quiz.questions) && quiz.questions.length > 0) {
        currentQuizQuestions = quiz.questions.map((q, idx) => ({
          indicator: q.indicator || `Step ${idx + 1}`,
          question_text: q.question_text || '',
          image_url: q.image_url || '',
          options: (q.options || []).map(opt => ({
            option_text: opt.option_text || '',
            outcome_key: opt.outcome_key || 'sunset_muse',
            image_url: opt.image_url || ''
          }))
        }));
      }

      renderQuizQuestionsBuilder();
      document.getElementById('quizFormHeading').textContent = 'Edit Interactive Quiz';
      document.getElementById('btnSaveQuiz').textContent = '💾 Update Quiz';
      document.getElementById('btnCancelQuizEdit').style.display = 'inline-block';

      // Switch to quizzes tab and scroll up
      const quizzesTabBtn = document.querySelector('[onclick*="\'quizzes\'"]');
      if (quizzesTabBtn) switchTab('quizzes', quizzesTabBtn);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function cancelQuizEdit() {
      document.getElementById('editQuizId').value = '';
      document.getElementById('quizTitle').value = '';
      document.getElementById('quizDescription').value = '';
      document.getElementById('quizFormHeading').textContent = '🔮 Interactive Quiz Studio & Builder';
      document.getElementById('btnSaveQuiz').textContent = '✨ Save & Publish Quiz';
      document.getElementById('btnCancelQuizEdit').style.display = 'none';
    }

    async function deleteQuiz(id) {
      if (!confirm('Are you sure you want to delete this quiz? All child questions and options will be removed.')) return;
      try {
        const res = await fetch(`/api/admin/quizzes?id=${id}`, { method: 'DELETE' });
        const data = await parseApiResponse(res);
        const isSuccess = data.success || res.ok || (typeof data.error === 'string' && data.error.includes('"success":true'));
        if (isSuccess) {
          const card = document.getElementById(`quiz-card-${id}`);
          if (card) card.remove();
          showToast('🗑️ Quiz deleted');
        } else {
          alert('Delete failed: ' + (data.error || 'Unknown error'));
        }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    // ==================== QUIZ PREVIEW MODAL CONTROLLER ====================
    let previewQuizStep = 0;
    let previewScores = { sunset_muse: 0, clean_girl: 0, cozy_vanilla: 0, downtown: 0 };
    let activePreviewQuestions = [];

    const archetypesData = {
      sunset_muse: {
        name: 'Sunset Muse ✨',
        tagline: 'The Golden Hour Tastemaker',
        desc: 'You thrive on warm golden-hour light, romanticizing everyday moments, layered effortless styling, and inspiring confidence in everyone around you.'
      },
      clean_girl: {
        name: 'Clean Girl Dew 🍵',
        tagline: 'The Glass Skin Minimalist',
        desc: 'Effortless gold tube hoops, glazed lip oil, slicked-back claw clips, and iced matcha. You bring organized elegance, clarity, and refreshing calm.'
      },
      cozy_vanilla: {
        name: 'Vanilla Warmth 🍦',
        tagline: 'The Cozy Room Romantic',
        desc: 'Chunky knit blankets, vanilla chai lattes, fairy lights, and reading romance books until 2 AM. Your gentle energy makes everyone feel at home.'
      },
      downtown: {
        name: 'Downtown Indie 🎸',
        tagline: 'The Vintage Vinyl Collector',
        desc: 'Oversized vintage leather jackets, thrift store crates, film cameras, and headphones on full blast. You move to your own beat with authentic downtown attitude.'
      }
    };

    function openQuizPreviewModal() {
      syncQuizQuestionsFromDOM();
      if (!currentQuizQuestions || currentQuizQuestions.length === 0) {
        alert('Please add at least 1 question before previewing.');
        return;
      }

      activePreviewQuestions = currentQuizQuestions;
      previewQuizStep = 0;
      previewScores = { sunset_muse: 0, clean_girl: 0, cozy_vanilla: 0, downtown: 0 };

      renderQuizPreviewStep();
      document.getElementById('quizPreviewModal').style.display = 'flex';
    }

    function previewExistingQuiz(quiz) {
      if (!quiz.questions || quiz.questions.length === 0) {
        alert('This quiz has no questions.');
        return;
      }
      activePreviewQuestions = quiz.questions.map((q, idx) => ({
        indicator: q.indicator || `Step ${idx + 1}`,
        question_text: q.question_text,
        options: (q.options || []).map(o => ({
          option_text: o.option_text,
          outcome_key: o.outcome_key
        }))
      }));
      previewQuizStep = 0;
      previewScores = { sunset_muse: 0, clean_girl: 0, cozy_vanilla: 0, downtown: 0 };

      renderQuizPreviewStep();
      document.getElementById('quizPreviewModal').style.display = 'flex';
    }

    function renderQuizPreviewStep() {
      document.getElementById('quizPreviewQuestionView').style.display = 'block';
      document.getElementById('quizPreviewOutcomeView').style.display = 'none';

      const total = activePreviewQuestions.length;
      const q = activePreviewQuestions[previewQuizStep];

      document.getElementById('quizPreviewStepBadge').textContent = `Step ${previewQuizStep + 1} of ${total}`;
      document.getElementById('quizPreviewIndicatorPill').textContent = (q.indicator || `Step ${previewQuizStep + 1}`).toUpperCase();
      document.getElementById('quizPreviewQuestionPrompt').textContent = q.question_text || 'Question Prompt';

      const optionsList = document.getElementById('quizPreviewOptionsList');
      optionsList.innerHTML = '';

      (q.options || []).forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'preview-quiz-option-card';
        btn.onclick = () => selectQuizPreviewOption(opt.outcome_key, btn);

        btn.innerHTML = `
          <span style="width:28px; height:28px; border-radius:50%; background:#FAF9F6; border:1px solid #E5E7EB; display:inline-flex; align-items:center; justify-content:center; font-size:0.8rem; font-weight:800; color:#4B5563;">${idx + 1}</span>
          <span style="flex-grow:1;">${escapeHtml(opt.option_text)}</span>
          <span style="font-size:0.75rem; color:#9CA3AF; text-transform:uppercase; font-weight:700;">${(opt.outcome_key || 'sunset_muse').replace('_', ' ')}</span>
        `;
        optionsList.appendChild(btn);
      });
    }

    function selectQuizPreviewOption(outcomeKey, btn) {
      if (btn) btn.classList.add('selected');
      if (previewScores[outcomeKey] !== undefined) {
        previewScores[outcomeKey]++;
      }

      setTimeout(() => {
        if (previewQuizStep + 1 < activePreviewQuestions.length) {
          previewQuizStep++;
          renderQuizPreviewStep();
        } else {
          showQuizPreviewOutcome();
        }
      }, 350);
    }

    function showQuizPreviewOutcome() {
      document.getElementById('quizPreviewQuestionView').style.display = 'none';
      document.getElementById('quizPreviewOutcomeView').style.display = 'block';

      // Find highest score
      let winningKey = 'sunset_muse';
      let maxScore = -1;
      for (const [key, score] of Object.entries(previewScores)) {
        if (score > maxScore) {
          maxScore = score;
          winningKey = key;
        }
      }

      const outcome = archetypesData[winningKey] || archetypesData.sunset_muse;
      document.getElementById('quizPreviewOutcomeTitle').textContent = outcome.name;
      document.getElementById('quizPreviewOutcomeTagline').textContent = outcome.tagline;
      document.getElementById('quizPreviewOutcomeDesc').textContent = outcome.desc;
    }

    function restartQuizPreview() {
      previewQuizStep = 0;
      previewScores = { sunset_muse: 0, clean_girl: 0, cozy_vanilla: 0, downtown: 0 };
      renderQuizPreviewStep();
    }

    function closeQuizPreviewModal() {
      const modal = document.getElementById('quizPreviewModal');
      if (modal) modal.style.display = 'none';
    }

    // Initialize Quiz Builder on page ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        renderQuizQuestionsBuilder();
      });
    } else {
      renderQuizQuestionsBuilder();
    }
  </script>

  <!-- Live Story Preview Modal -->
