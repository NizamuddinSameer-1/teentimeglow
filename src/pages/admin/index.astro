---
import '@/styles/global.css';
import { supabase, getAdminClient } from '@/lib/supabase';
import type { CommunityCreation, Post, Wallpaper, StoryMemeQuote } from '@/types/database';

export const prerender = false;

// Route Guard: Require valid admin session
const adminSession = Astro.cookies.get('ttg_admin_session')?.value;
const expectedSecret = process.env.ADMIN_SECRET_KEY || 'rini-glow-2026';
if (!adminSession || adminSession !== expectedSecret) {
  return Astro.redirect('/admin/login');
}

const adminClient = getAdminClient();

// Fetch live database counts & items
const [
  { data: pendingCreations },
  { data: approvedCreations },
  { data: posts },
  { data: wallpapers },
  { data: quotes }
] = await Promise.all([
  adminClient.from('community_creations').select('*').eq('status', 'pending').order('created_at', { ascending: false }),
  adminClient.from('community_creations').select('*').eq('status', 'approved').order('created_at', { ascending: false }),
  adminClient.from('posts').select('*').order('created_at', { ascending: false }),
  adminClient.from('wallpapers').select('*').order('created_at', { ascending: false }),
  adminClient.from('stories_memes_quotes').select('*').order('created_at', { ascending: false })
]);

const pendingList = (pendingCreations || []) as CommunityCreation[];
const approvedList = (approvedCreations || []) as CommunityCreation[];
const postsList = (posts || []) as Post[];
const wallpapersList = (wallpapers || []) as Wallpaper[];
const quotesList = (quotes || []) as StoryMemeQuote[];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Rini's Admin Cockpit — TeenTimeGlow</title>
  <link rel="icon" type="image/jpeg" href="/assets/logo.jpg" />
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Syne:wght@700;800&display=swap" rel="stylesheet" />

  <style>
    body {
      background-color: #FAF7F2;
      color: #0F1115;
      font-family: var(--font-body);
      min-height: 100vh;
      margin: 0;
      padding: 0;
    }

    .admin-nav {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(17, 24, 39, 0.08);
      position: sticky;
      top: 0;
      z-index: 100;
      padding: 16px 24px;
    }

    .admin-nav-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .admin-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: inherit;
    }

    .admin-brand img {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 1.5px solid var(--sunset-accent);
    }

    .admin-badge {
      background: var(--brand-green);
      color: #FFF;
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 999px;
      letter-spacing: 0.05em;
    }

    .admin-container {
      max-width: 1200px;
      margin: 32px auto;
      padding: 0 24px;
    }

    .stat-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
      margin-bottom: 32px;
    }

    .stat-card {
      background: #FFFFFF;
      border: 1px solid rgba(17, 24, 39, 0.08);
      border-radius: 16px;
      padding: 20px 24px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
    }

    .stat-card-title {
      font-size: 0.82rem;
      font-weight: 700;
      color: #6B7280;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .stat-card-val {
      font-size: 2.2rem;
      font-weight: 800;
      font-family: var(--font-syne);
      margin-top: 8px;
      color: #0F1115;
    }

    .stat-highlight {
      color: var(--sunset-accent);
    }

    /* Tabs */
    .admin-tabs {
      display: flex;
      gap: 12px;
      margin-bottom: 24px;
      border-bottom: 1px solid rgba(17, 24, 39, 0.1);
      padding-bottom: 12px;
    }

    .admin-tab-btn {
      background: none;
      border: none;
      padding: 10px 18px;
      border-radius: 999px;
      font-size: 0.92rem;
      font-weight: 700;
      cursor: pointer;
      color: #6B7280;
      transition: all 0.2s ease;
    }

    .admin-tab-btn.active {
      background: #0F1115;
      color: #FFFFFF;
    }

    .admin-panel {
      display: none;
    }

    .admin-panel.active {
      display: block;
    }

    /* Creation Card */
    .creations-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 24px;
    }

    .admin-creation-card {
      background: #FFFFFF;
      border: 1px solid rgba(17, 24, 39, 0.08);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
      display: flex;
      flex-direction: column;
    }

    .admin-creation-thumb {
      width: 100%;
      height: 220px;
      object-fit: cover;
      background: #F3F4F6;
    }

    .admin-creation-body {
      padding: 20px;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .admin-creation-actions {
      display: flex;
      gap: 10px;
      margin-top: 16px;
    }

    .btn-approve {
      flex: 1;
      background: #0C3B2E;
      color: #FFF;
      border: none;
      padding: 10px;
      border-radius: 8px;
      font-weight: 700;
      cursor: pointer;
      transition: opacity 0.2s;
    }

    .btn-reject {
      background: #FFF;
      border: 1px solid #DC2626;
      color: #DC2626;
      padding: 10px 14px;
      border-radius: 8px;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-approve:hover { opacity: 0.9; }
    .btn-reject:hover { background: #FEE2E2; }

    /* Form Styles */
    .admin-form-card {
      background: #FFFFFF;
      border: 1px solid rgba(17, 24, 39, 0.08);
      border-radius: 16px;
      padding: 32px;
      max-width: 680px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-label {
      display: block;
      font-size: 0.88rem;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .form-input, .form-textarea, .form-select {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #D1D5DB;
      border-radius: 8px;
      font-family: inherit;
      font-size: 0.92rem;
      box-sizing: border-box;
    }

    .btn-submit-post {
      background: var(--sunset-gradient);
      color: #FFF;
      border: none;
      padding: 14px 24px;
      border-radius: 999px;
      font-size: 0.95rem;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 4px 16px rgba(232, 93, 4, 0.25);
    }

    .btn-logout {
      background: none;
      border: 1px solid #D1D5DB;
      color: #4B5563;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-logout:hover {
      background: #FEE2E2;
      border-color: #DC2626;
      color: #DC2626;
    }

    .sub-tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 20px;
      border-bottom: 1px solid #E5E7EB;
      padding-bottom: 8px;
    }

    .sub-tab-btn {
      background: none;
      border: none;
      padding: 6px 14px;
      border-radius: 8px;
      font-size: 0.88rem;
      font-weight: 700;
      cursor: pointer;
      color: #6B7280;
      transition: all 0.2s;
    }

    .sub-tab-btn.active {
      background: rgba(232, 93, 4, 0.1);
      color: var(--sunset-accent);
    }
  </style>
</head>
<body>

  <nav class="admin-nav">
    <div class="admin-nav-inner">
      <a href="/" class="admin-brand">
        <img src="/assets/logo.jpg" alt="Logo" />
        <span style="font-family: var(--font-editorial); font-size: 1.2rem; font-weight: 700;">teen time <span style="font-style: italic; color: var(--sunset-accent);">glow.</span></span>
        <span class="admin-badge">Admin Cockpit</span>
      </a>
      <div style="display: flex; gap: 12px; align-items: center;">
        <a href="/" style="font-size: 0.88rem; font-weight: 700; text-decoration: none; color: #4B5563;">View Live Site ↗</a>
        <button class="btn-logout" onclick="handleLogout()">Logout ⎋</button>
      </div>
    </div>
  </nav>

  <main class="admin-container">
    <!-- Top Stats Bar -->
    <div class="stat-cards-grid">
      <div class="stat-card">
        <div class="stat-card-title">Pending Moderation</div>
        <div class="stat-card-val stat-highlight">{pendingList.length}</div>
      </div>
      <div class="stat-card">
        <div class="stat-card-title">Approved Community</div>
        <div class="stat-card-val">{approvedList.length}</div>
      </div>
      <div class="stat-card">
        <div class="stat-card-title">Editorial Edits</div>
        <div class="stat-card-val">{postsList.length}</div>
      </div>
      <div class="stat-card">
        <div class="stat-card-title">Wallpapers Vault</div>
        <div class="stat-card-val">{wallpapersList.length}</div>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="admin-tabs">
      <button class="admin-tab-btn active" onclick="switchAdminTab('inbox', this)">📬 Moderation Inbox ({pendingList.length})</button>
      <button class="admin-tab-btn" onclick="switchAdminTab('publish', this)">✍️ Zero-Code Publisher</button>
      <button class="admin-tab-btn" onclick="switchAdminTab('gallery', this)">🖼️ Approved Gallery ({approvedList.length})</button>
      <button class="admin-tab-btn" onclick="switchAdminTab('posts', this)">📖 All Posts ({postsList.length})</button>
    </div>

    <!-- Panel 1: Moderation Inbox -->
    <div id="panel-inbox" class="admin-panel active">
      <h2 style="font-size: 1.4rem; font-weight: 800; margin-bottom: 16px;">Community Submissions Awaiting Approval</h2>
      {pendingList.length === 0 ? (
        <div style="background: #FFF; border-radius: 16px; padding: 48px; text-align: center; border: 1px dashed #D1D5DB;">
          <div style="font-size: 2.5rem; margin-bottom: 12px;">🎉</div>
          <h3 style="font-size: 1.2rem; font-weight: 700;">Inbox is all clear!</h3>
          <p style="color: #6B7280; font-size: 0.9rem; margin-top: 4px;">No new creations waiting for review. All clean!</p>
        </div>
      ) : (
        <div class="creations-grid">
          {pendingList.map((item) => (
            <div class="admin-creation-card" id={`card-${item.id}`}>
              <img src={item.image_url} alt={item.caption || 'Upload'} class="admin-creation-thumb" />
              <div class="admin-creation-body">
                <div>
                  <span style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--sunset-accent);">{item.category}</span>
                  <h4 style="font-size: 1.1rem; font-weight: 700; margin: 4px 0;">{item.caption || 'Untitled Creation'}</h4>
                  <p style="font-size: 0.85rem; color: #6B7280; margin: 4px 0;">by <strong>{item.author_social || item.author_name}</strong></p>
                  <p style="font-size: 0.75rem; color: #9CA3AF;">Submitted {new Date(item.created_at).toLocaleDateString()}</p>
                </div>
                <div class="admin-creation-actions">
                  <button class="btn-approve" onclick={`moderateCreation('${item.id}', 'approved')`}>✓ Approve</button>
                  <button class="btn-reject" onclick={`moderateCreation('${item.id}', 'rejected')`}>✕ Reject</button>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Panel 2: Zero-Code Publisher -->
    <div id="panel-publish" class="admin-panel">
      <div class="admin-form-card">
        <h2 style="font-size: 1.4rem; font-weight: 800; margin-bottom: 8px;">Zero-Code Content Publisher</h2>
        <p style="font-size: 0.9rem; color: #6B7280; margin-bottom: 20px;">Publish articles, wallpapers, or inspirational quotes directly to your live website with zero coding.</p>

        <!-- Sub-tabs for content types -->
        <div class="sub-tabs">
          <button type="button" class="sub-tab-btn active" onclick="switchPublishType('post', this)">📝 Article / Edit</button>
          <button type="button" class="sub-tab-btn" onclick="switchPublishType('wallpaper', this)">🖼️ 4K Wallpaper</button>
          <button type="button" class="sub-tab-btn" onclick="switchPublishType('quote', this)">💬 Daily Quote / Affirmation</button>
        </div>

        <!-- Form 1: Article / Edit -->
        <form id="form-publish-post" onsubmit="handlePublishPost(event)">
          <div class="form-group">
            <label class="form-label">Article Title *</label>
            <input type="text" id="postTitle" required placeholder="e.g. 5 Korean Lip Oils That Give Glass Gloss" class="form-input" />
          </div>

          <div class="form-group">
            <label class="form-label">Category *</label>
            <select id="postCategory" class="form-select">
              <option value="beauty">Beauty & Skincare</option>
              <option value="fashion">Fashion Lookbook</option>
              <option value="decor">Cozy Decor</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Short Summary (Excerpt) *</label>
            <textarea id="postExcerpt" rows="3" required placeholder="Brief 1-2 sentence teaser for the card..." class="form-textarea"></textarea>
          </div>

          <div class="form-group">
            <label class="form-label">Cover Image URL *</label>
            <input type="text" id="postImage" required value="/assets/feature-skincare.jpg" class="form-input" />
          </div>

          <div class="form-group">
            <label class="form-label">Full Article HTML / Story Content</label>
            <textarea id="postContent" rows="5" placeholder="<p>Full article text here...</p>" class="form-textarea"></textarea>
          </div>

          <button type="submit" class="btn-submit-post">🚀 Publish Article to Home Page</button>
        </form>

        <!-- Form 2: 4K Wallpaper -->
        <form id="form-publish-wallpaper" style="display: none;" onsubmit="handlePublishWallpaper(event)">
          <div class="form-group">
            <label class="form-label">Wallpaper Title *</label>
            <input type="text" id="wpTitle" required placeholder="e.g. Velvet Sunset Reflections" class="form-input" />
          </div>

          <div class="form-group">
            <label class="form-label">Device Type *</label>
            <select id="wpDevice" class="form-select">
              <option value="mobile">iPhone / Mobile (9:16)</option>
              <option value="desktop">Desktop / Laptop (16:9)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Thumbnail Image URL *</label>
            <input type="text" id="wpThumb" required value="/assets/wallpaper-clouds.jpg" class="form-input" />
          </div>

          <div class="form-group">
            <label class="form-label">Full 4K Download URL</label>
            <input type="text" id="wpDownload" placeholder="Leave empty to use thumbnail URL" class="form-input" />
          </div>

          <button type="submit" class="btn-submit-post">📥 Publish 4K Wallpaper to Vault</button>
        </form>

        <!-- Form 3: Daily Quote / Affirmation -->
        <form id="form-publish-quote" style="display: none;" onsubmit="handlePublishQuote(event)">
          <div class="form-group">
            <label class="form-label">Quote or Affirmation Text *</label>
            <textarea id="quoteText" rows="4" required placeholder="e.g. You don't need anyone's permission to glow into who you are meant to be." class="form-textarea"></textarea>
          </div>

          <div class="form-group">
            <label class="form-label">Author / Attribution</label>
            <input type="text" id="quoteAuthor" value="Rini" placeholder="e.g. Rini or TeenTimeGlow" class="form-input" />
          </div>

          <button type="submit" class="btn-submit-post">✨ Publish Daily Affirmation</button>
        </form>
      </div>
    </div>

    <!-- Panel 3: Approved Gallery -->
    <div id="panel-gallery" class="admin-panel">
      <h2 style="font-size: 1.4rem; font-weight: 800; margin-bottom: 16px;">Live Community Creations</h2>
      <div class="creations-grid">
        {approvedList.map((item) => (
          <div class="admin-creation-card" id={`card-${item.id}`}>
            <img src={item.image_url} alt={item.caption || 'Creation'} class="admin-creation-thumb" />
            <div class="admin-creation-body">
              <div>
                <span style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--brand-green);">Status: Approved</span>
                <h4 style="font-size: 1.1rem; font-weight: 700; margin: 4px 0;">{item.caption || 'Untitled'}</h4>
                <p style="font-size: 0.85rem; color: #6B7280;">by <strong>{item.author_social || item.author_name}</strong> • ♡ {item.likes_count} likes</p>
              </div>
              <div class="admin-creation-actions" style="margin-top: 12px;">
                <button class="btn-reject" style="width: 100%;" onclick={`moderateCreation('${item.id}', 'rejected')`}>Remove from Public</button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Panel 4: All Posts -->
    <div id="panel-posts" class="admin-panel">
      <h2 style="font-size: 1.4rem; font-weight: 800; margin-bottom: 16px;">Published Posts ({postsList.length})</h2>
      <div style="background: #FFF; border-radius: 16px; overflow: hidden; border: 1px solid rgba(17,24,39,0.08);">
        {postsList.map((post, idx) => (
          <div style={`display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: ${idx === postsList.length - 1 ? 'none' : '1px solid #F3F4F6'}; gap: 16px;`}>
            <div style="display: flex; align-items: center; gap: 16px;">
              <img src={post.cover_image_url} alt={post.title} style="width: 48px; height: 48px; border-radius: 8px; object-fit: cover;" />
              <div>
                <div style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--sunset-accent);">{post.category}</div>
                <div style="font-weight: 700; font-size: 0.95rem;">{post.title}</div>
              </div>
            </div>
            <span style="font-size: 0.8rem; color: #10B981; font-weight: 700;">● Live</span>
          </div>
        ))}
      </div>
    </div>
  </main>

  <script is:inline>
    async function handleLogout() {
      if (!confirm('Log out from Admin Cockpit?')) return;
      try {
        await fetch('/api/admin/logout', { method: 'POST' });
        window.location.href = '/admin/login';
      } catch {
        window.location.href = '/admin/login';
      }
    }

    function switchAdminTab(tabName, btn) {
      document.querySelectorAll('.admin-tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.admin-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      const target = document.getElementById(`panel-${tabName}`);
      if (target) target.classList.add('active');
    }

    function switchPublishType(type, btn) {
      document.querySelectorAll('.sub-tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      ['post', 'wallpaper', 'quote'].forEach(t => {
        const form = document.getElementById(`form-publish-${t}`);
        if (form) form.style.display = t === type ? 'block' : 'none';
      });
    }

    async function moderateCreation(id, action) {
      if (!confirm(`Are you sure you want to mark this item as ${action}?`)) return;

      try {
        const res = await fetch('/api/admin/moderate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, action })
        });
        const data = await res.json();
        if (data.success) {
          alert(`Item ${action}!`);
          const card = document.getElementById(`card-${id}`);
          if (card) card.remove();
        } else {
          alert('Error: ' + (data.error || 'Failed'));
        }
      } catch (err) {
        alert('Network error: ' + err.message);
      }
    }

    async function handlePublishPost(e) {
      e.preventDefault();
      const title = document.getElementById('postTitle').value;
      const category = document.getElementById('postCategory').value;
      const excerpt = document.getElementById('postExcerpt').value;
      const cover_image_url = document.getElementById('postImage').value;
      const content_html = document.getElementById('postContent').value;

      try {
        const res = await fetch('/api/admin/publish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: 'post',
            data: { title, category, excerpt, cover_image_url, content_html }
          })
        });
        const data = await res.json();
        if (data.success) {
          alert('🎉 Post published successfully to the homepage!');
          window.location.reload();
        } else {
          alert('Error: ' + (data.error || 'Failed to publish'));
        }
      } catch (err) {
        alert('Network error: ' + err.message);
      }
    }

    async function handlePublishWallpaper(e) {
      e.preventDefault();
      const title = document.getElementById('wpTitle').value;
      const device_type = document.getElementById('wpDevice').value;
      const thumbnail_url = document.getElementById('wpThumb').value;
      const download_url = document.getElementById('wpDownload').value || thumbnail_url;

      try {
        const res = await fetch('/api/admin/publish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: 'wallpaper',
            data: { title, device_type, thumbnail_url, download_url }
          })
        });
        const data = await res.json();
        if (data.success) {
          alert('🎉 4K Wallpaper published successfully to vault!');
          window.location.reload();
        } else {
          alert('Error: ' + (data.error || 'Failed to publish'));
        }
      } catch (err) {
        alert('Network error: ' + err.message);
      }
    }

    async function handlePublishQuote(e) {
      e.preventDefault();
      const content_text = document.getElementById('quoteText').value;
      const author = document.getElementById('quoteAuthor').value || 'Rini';

      try {
        const res = await fetch('/api/admin/publish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: 'quote',
            data: { content_text, author }
          })
        });
        const data = await res.json();
        if (data.success) {
          alert('🎉 Daily Affirmation published successfully!');
          window.location.reload();
        } else {
          alert('Error: ' + (data.error || 'Failed to publish'));
        }
      } catch (err) {
        alert('Network error: ' + err.message);
      }
    }
  </script>
</body>
</html>
