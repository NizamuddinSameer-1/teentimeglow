---
import '@/styles/global.css';

export const prerender = false;

import { isValidSessionToken, ADMIN_SESSION_COOKIE } from '@/lib/admin-auth';

// If already signed in (verified signed token), go straight to the Studio
let sessionValid = false;
try {
  sessionValid = isValidSessionToken(Astro.cookies.get(ADMIN_SESSION_COOKIE)?.value);
} catch {
  sessionValid = false;
}
if (sessionValid) {
  return Astro.redirect('/admin');
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login — TeenTimeGlow Cockpit</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/jpeg" href="/assets/logo.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Syne:wght@700;800&display=swap" rel="stylesheet" />

  <style>
    body {
      background: radial-gradient(circle at top right, rgba(232, 93, 4, 0.08), transparent 60%),
                  radial-gradient(circle at bottom left, rgba(12, 59, 46, 0.05), transparent 60%),
                  #FAF7F2;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-body);
      color: #0F1115;
      margin: 0;
      padding: 24px;
    }

    .login-card {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(17, 24, 39, 0.08);
      border-radius: 24px;
      padding: 44px 36px;
      width: 100%;
      max-width: 440px;
      box-shadow: 0 20px 40px -15px rgba(232, 93, 4, 0.12), 0 0 1px 1px rgba(0,0,0,0.03);
      text-align: center;
    }

    .login-brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 24px;
      text-decoration: none;
      color: inherit;
    }

    .login-brand img {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      border: 2px solid var(--sunset-accent);
    }

    .login-title {
      font-family: var(--font-editorial);
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin: 0 0 8px 0;
    }

    .login-subtitle {
      font-size: 0.92rem;
      color: #6B7280;
      margin: 0 0 32px 0;
    }

    .form-group {
      text-align: left;
      margin-bottom: 24px;
    }

    .form-label {
      display: block;
      font-size: 0.85rem;
      font-weight: 700;
      margin-bottom: 8px;
      color: #374151;
    }

    .form-input {
      width: 100%;
      padding: 14px 16px;
      border: 1.5px solid #E5E7EB;
      border-radius: 12px;
      font-size: 0.95rem;
      font-family: inherit;
      box-sizing: border-box;
      transition: all 0.2s ease;
      background: #F9FAFB;
    }

    .form-input:focus {
      outline: none;
      border-color: var(--sunset-accent);
      background: #FFFFFF;
      box-shadow: 0 0 0 4px rgba(232, 93, 4, 0.12);
    }

    .btn-login {
      width: 100%;
      background: var(--sunset-gradient);
      color: #FFFFFF;
      border: none;
      padding: 15px;
      border-radius: 12px;
      font-size: 1rem;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 8px 20px -4px rgba(232, 93, 4, 0.4);
      transition: all 0.2s ease;
    }

    .btn-login:hover {
      transform: translateY(-1px);
      box-shadow: 0 12px 24px -4px rgba(232, 93, 4, 0.5);
    }

    .login-error {
      display: none;
      background: #FEE2E2;
      color: #DC2626;
      font-size: 0.88rem;
      font-weight: 600;
      padding: 10px 14px;
      border-radius: 8px;
      margin-bottom: 20px;
      text-align: center;
    }

    .back-link {
      display: inline-block;
      margin-top: 24px;
      font-size: 0.88rem;
      font-weight: 700;
      color: #6B7280;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .back-link:hover {
      color: var(--sunset-accent);
    }
  </style>
</head>
<body>

  <div class="login-card">
    <a href="/" class="login-brand">
      <img src="/assets/logo.jpg" alt="Logo" />
      <span style="font-family: var(--font-editorial); font-size: 1.3rem; font-weight: 700;">
        teen time <span style="font-style: italic; color: var(--sunset-accent);">glow.</span>
      </span>
    </a>

    <h1 class="login-title">Welcome, Rini ✨</h1>
    <p class="login-subtitle">Enter your secret passkey to access your personal Studio.</p>

    <div id="loginError" class="login-error"></div>

    <form onsubmit="handleLogin(event)">
      <div class="form-group">
        <label class="form-label" for="password">Studio Passkey</label>
        <input
          type="password"
          id="password"
          name="password"
          required
          placeholder="Enter your passkey..."
          class="form-input"
          autocomplete="current-password"
        />
      </div>

      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 24px; text-align: left;">
        <input type="checkbox" id="rememberMe" checked style="width: 18px; height: 18px; accent-color: var(--sunset-accent); cursor: pointer;" />
        <label for="rememberMe" style="font-size: 0.88rem; color: #4B5563; font-weight: 600; cursor: pointer; user-select: none;">
          Keep me signed in on this device (30 days)
        </label>
      </div>

      <button type="submit" id="submitBtn" class="btn-login">
        Open Studio ✨
      </button>
    </form>

    <a href="/" class="back-link">← Return to TeenTimeGlow Public Site</a>
  </div>

  <script is:inline>
    async function handleLogin(e) {
      e.preventDefault();
      const passwordInput = document.getElementById('password');
      const rememberMeInput = document.getElementById('rememberMe');
      const errorDiv = document.getElementById('loginError');
      const submitBtn = document.getElementById('submitBtn');

      const password = passwordInput.value;
      const rememberMe = rememberMeInput ? rememberMeInput.checked : true;
      if (!password) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Opening Studio... ✨';
      errorDiv.style.display = 'none';

      try {
        const res = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password, rememberMe })
        });
        const contentType = res.headers.get('content-type') || '';
        const data = contentType.includes('application/json')
          ? await res.json()
          : { error: (await res.text()) || 'Login failed' };

        if (data.success) {
          window.location.href = '/admin';
        } else {
          errorDiv.textContent = data.error || 'Invalid credentials';
          errorDiv.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Open Studio ✨';
        }
      } catch (err) {
        errorDiv.textContent = 'Network error: ' + err.message;
        errorDiv.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Open Studio ✨';
      }
    }
  </script>
</body>
</html>
