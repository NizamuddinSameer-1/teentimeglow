    font-family: var(--font-editorial, 'Playfair Display', serif);
    font-size: 1.6rem;
    color: #111827;
    margin-bottom: 8px;
  }

  .gallery-empty-state p {
    font-size: 0.95rem;
    color: #6B7280;
    margin-bottom: 20px;
  }

  /* Creator Spotlight */
  .creator-spotlight-section {
    margin-bottom: 60px;
  }

  .spotlight-card {
    background: linear-gradient(135deg, #111827 0%, #1F2937 100%);
    border-radius: 28px;
    padding: 48px;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    position: relative;
    overflow: hidden;
  }

  .spotlight-card::before {
    content: '';
