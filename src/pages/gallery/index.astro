    border-radius: 9999px;
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 700;
    backdrop-filter: blur(8px);
    letter-spacing: 0.02em;
  }

  .drop-creator-badge {
    position: absolute;
    bottom: 14px;
    left: 14px;
    padding: 5px 12px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 9999px;
    color: #111827;
    font-size: 0.75rem;
    font-weight: 800;
