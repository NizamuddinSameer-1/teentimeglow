---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts } from '@/lib/api';
import { SITE_URL, CATEGORIES, categoryBySlug, absoluteUrl } from '@/config/seo';
import type { Post } from '@/types/database';

export const prerender = false;

const { category: categorySlug } = Astro.params;
const category = categorySlug ? categoryBySlug(categorySlug) : undefined;

if (!category) {
  return Astro.rewrite('/404');
}

const allPosts: Post[] = await getPosts();
const posts = allPosts.filter((p) => p.category === category.dbValue);

const pageUrl = absoluteUrl(`/edits/category/${category.slug}`);
const pageTitle = `${category.title} | TeenTimeGlow`;
const otherCategories = CATEGORIES.filter((c) => c.slug !== category.slug);

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${pageUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Magazine', item: `${SITE_URL}/edits` },
    { '@type': 'ListItem', position: 3, name: category.label, item: pageUrl }
  ]
};

const collectionSchema = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  url: pageUrl,
  name: category.title,
  description: category.description,
  isPartOf: { '@id': `${SITE_URL}/#website` },
  inLanguage: 'en',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: absoluteUrl(`/edits/${p.slug}`),
      name: p.title
    }))
  }
};
---

<BaseLayout title={pageTitle} description={category.description} schema={[breadcrumbSchema, collectionSchema]}>
  <main class="cat-page">
    <div class="container breadcrumb-wrap">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/" class="breadcrumb-link">Home</a>
        <span class="breadcrumb-sep">/</span>
        <a href="/edits" class="breadcrumb-link">Magazine</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">{category.label}</span>
      </nav>
    </div>

    <section class="cat-hero container">
      <span class="cat-pill">✦ {category.label}</span>
      <h1 class="cat-title">{category.h1}</h1>
      <p class="cat-intro">{category.description}</p>
    </section>

    <section class="cat-grid-section container">
      {posts.length > 0 ? (
        <div class="cat-grid">
          {posts.map((post) => (
            <a href={`/edits/${post.slug}`} class="cat-card">
              <div class="cat-thumb">
                <img
                  src={post.cover_image_url}
                  alt={post.title}
                  width="640"
                  height="440"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="cat-card-body">
                <span class="cat-read">{post.read_time_minutes} min read</span>
                <h2 class="cat-card-title">{post.title}</h2>
                <p class="cat-card-excerpt">{post.excerpt}</p>
                <span class="cat-read-more">Read the edit &rarr;</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="cat-empty">New {category.label.toLowerCase()} guides are publishing soon. Check back shortly.</p>
      )}
    </section>

    <section class="cat-related container">
      <h2 class="cat-related-title">Keep exploring</h2>
      <div class="cat-related-links">
        {otherCategories.map((c) => (
          <a href={`/edits/category/${c.slug}`} class="cat-related-link">
            <span class="cat-related-label">{c.label}</span>
            <span class="cat-related-sub">{c.keywords[0]}</span>
          </a>
        ))}
        <a href="/edits" class="cat-related-link">
          <span class="cat-related-label">All Edits</span>
          <span class="cat-related-sub">every guide in one place</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .cat-page {
    padding-top: 110px;
    padding-bottom: 90px;
    background: #FAF7F2;
    min-height: 100vh;
  }
  .breadcrumb-wrap {
    margin-bottom: 26px;
  }
  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    font-weight: 600;
  }
  .breadcrumb-link {
    color: var(--text-muted);
    text-decoration: none;
  }
  .breadcrumb-link:hover {
    color: var(--sunset-accent);
  }
  .breadcrumb-sep {
    color: #CBD5E1;
  }
  .breadcrumb-current {
    color: #111827;
  }

  .cat-hero {
    max-width: 780px;
    margin-bottom: 48px;
  }
  .cat-pill {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--sunset-accent);
    background: rgba(232, 93, 4, 0.08);
    padding: 5px 13px;
    border-radius: 999px;
    margin-bottom: 16px;
  }
  .cat-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    line-height: 1.08;
    color: #0F1115;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }
  .cat-intro {
    font-size: 1.06rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .cat-card {
    background: #fff;
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .cat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(232, 93, 4, 0.12);
  }
  .cat-thumb {
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: #111827;
  }
  .cat-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cat-card-body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    flex: 1;
  }
  .cat-read {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--text-muted);
  }
  .cat-card-title {
    font-family: var(--font-editorial);
    font-size: 1.22rem;
    line-height: 1.35;
    color: #111827;
  }
  .cat-card-excerpt {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-muted);
    flex: 1;
  }
  .cat-read-more {
    font-size: 0.84rem;
    font-weight: 800;
    color: var(--sunset-accent);
  }
  .cat-empty {
    color: var(--text-muted);
  }

  .cat-related {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--border-subtle);
  }
  .cat-related-title {
    font-family: var(--font-editorial);
    font-size: 1.4rem;
    color: #0F1115;
    margin-bottom: 18px;
  }
  .cat-related-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cat-related-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 22px;
    background: #fff;
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .cat-related-link:hover {
    border-color: var(--sunset-accent);
  }
  .cat-related-label {
    font-weight: 800;
    color: #111827;
    font-size: 0.92rem;
  }
  .cat-related-sub {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  @media (max-width: 960px) {
    .cat-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .cat-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
