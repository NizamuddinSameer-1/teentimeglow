---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPostBySlug, getPosts } from '@/lib/api';
import { sanitizeArticleHtml } from '@/lib/sanitize';
import { SITE_URL, LOGO_URL, AUTHOR, absoluteUrl, categoryByDbValue } from '@/config/seo';
import type { Post } from '@/types/database';

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.rewrite('/404');
}

const post: Post | null = await getPostBySlug(slug);

// Previously this redirected unknown slugs to /edits with a 200 response,
// which tells Google "this URL is fine, it just shows the index". That creates
// an unlimited supply of soft-404s and burns crawl budget. Rewriting to /404
// keeps the URL intact and returns a genuine not-found state.
if (!post) {
  return Astro.rewrite('/404');
}

const allPosts: Post[] = await getPosts();

const category = categoryByDbValue(post.category);
const categoryLabel = category?.label || post.category;
const categoryUrl = category ? `/edits/category/${category.slug}` : '/edits';

// Related posts prefer the same category — that is what makes internal links
// topically relevant instead of random.
const sameCategory = allPosts.filter(p => p.slug !== post.slug && p.category === post.category);
const otherCategory = allPosts.filter(p => p.slug !== post.slug && p.category !== post.category);
const relatedPosts = [...sameCategory, ...otherCategory].slice(0, 3);

const postUrl = absoluteUrl(`/edits/${post.slug}`);

// ---------------------------------------------------------------------------
// Table of contents built from the real <h2> headings in the article body.
// The old sidebar listed three hardcoded labels ("Mindset & Preparation"…)
// for every article regardless of content, and none of them were clickable.
// ---------------------------------------------------------------------------
function slugifyHeading(text: string): string {
  return text
    .toLowerCase()
    .replace(/<[^>]+>/g, '')
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-')
    .slice(0, 60);
}

function buildTocAndContent(html: string): { html: string; toc: { id: string; text: string }[] } {
  const toc: { id: string; text: string }[] = [];
  const used = new Set<string>();

  const out = html.replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/gi, (_match, attrs: string, inner: string) => {
    const text = inner.replace(/<[^>]+>/g, '').trim();
    if (!text) return _match;

    const existingId = /\bid=["']([^"']+)["']/i.exec(attrs)?.[1];
    let id = existingId || slugifyHeading(text);
    if (!id) return _match;

    let unique = id;
    let n = 2;
    while (used.has(unique)) unique = `${id}-${n++}`;
    used.add(unique);

    if (!existingId) {
      toc.push({ id: unique, text });
      return `<h2${attrs} id="${unique}">${inner}</h2>`;
    }
    toc.push({ id: existingId, text });
    return _match;
  });

  return { html: out, toc };
}

const { html: articleHtml, toc } = buildTocAndContent(sanitizeArticleHtml(post.content_html || ''));

// Word count from the rendered body — useful for Article schema and for
// spotting thin content during editorial review.
const wordCount = (post.content_html || '')
  .replace(/<[^>]+>/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length;

const coverImage = absoluteUrl(post.cover_image_url || '/assets/hero-glow-creator.jpg');

const articleSchema = {
  '@type': 'BlogPosting',
  '@id': `${postUrl}#article`,
  headline: post.title,
  description: post.excerpt,
  image: {
    '@type': 'ImageObject',
    url: coverImage,
    width: 1200,
    height: 675
  },
  datePublished: post.created_at || '2026-10-18T00:00:00Z',
  dateModified: post.updated_at || post.created_at || '2026-10-18T00:00:00Z',
  author: { '@id': `${SITE_URL}/#person-rini` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  articleSection: categoryLabel,
  inLanguage: 'en',
  wordCount,
  isAccessibleForFree: true,
  url: postUrl
};

const isGlassSkinRoutine = post.slug === 'glass-skin-korean-routine';
const howToSchema = isGlassSkinRoutine ? {
  '@type': 'HowTo',
  '@id': `${postUrl}#howto`,
  name: 'The 5-Step Korean Glass Skin Routine for School Days',
  description: 'A gentle, hydrating morning skincare routine designed specifically for teenagers to achieve glowing skin without damaging the skin barrier.',
  totalTime: 'PT8M',
  estimatedCost: {
    '@type': 'MonetaryAmount',
    currency: 'USD',
    value: '25'
  },
  supply: [
    { '@type': 'HowToSupply', name: 'Low pH Gentle Cleanser' },
    { '@type': 'HowToSupply', name: 'Hydrating Essence Toner (Centella / Hyaluronic Acid)' },
    { '@type': 'HowToSupply', name: 'Barrier Serum (Niacinamide 2-5%)' },
    { '@type': 'HowToSupply', name: 'Lightweight Gel Cream' },
    { '@type': 'HowToSupply', name: 'Broad Spectrum SPF 50 Sunscreen' }
  ],
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Gentle Low-pH Water Cleanse',
      text: 'Wash your face with lukewarm water and a low pH foaming cleanser to clear oil without stripping your natural skin barrier.'
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Hydrating Essence Toner Layering',
      text: 'Pat 2 thin layers of hydrating toner into damp skin. Never rub or pull; let it absorb naturally.'
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Barrier Recovery Serum',
      text: 'Apply 2-3 drops of gentle Niacinamide or Centella serum to calm redness and regulate sebum production.'
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Glow-Lock Gel Moisturizer',
      text: 'Seal hydration with a lightweight, non-comedogenic ceramide gel cream.'
    },
    {
      '@type': 'HowToStep',
      position: 5,
      name: 'Non-Greasy Daily SPF 50',
      text: 'Finish with 2 finger-lengths of broad-spectrum SPF to protect your skin barrier from UV damage.'
    }
  ]
} : null;
const faqsBySlug: Record<string, { q: string; a: string }[]> = {
  'glass-skin-korean-routine': [
    {
      q: 'Can teens with acne do the Korean glass skin routine?',
      a: 'Yes. The key for acne-prone teen skin is skipping heavy face oils and using oil-free hydrating toners and gentle barrier repair ingredients like Centella Asiatica.'
    },
    {
      q: 'What age is suitable to start a skincare routine?',
      a: 'Simple routines focusing on gentle cleansing, light hydration, and daily sun protection can safely begin in the early teen years (ages 12-14).'
    },
    {
      q: 'Do I need expensive products to get glass skin?',
      a: 'No. Glass skin is about hydration consistency and technique rather than luxury brands. Budget drugstore options with simple ingredients work effectively.'
    }
  ],
  'capsule-wardrobe-for-teens-on-a-budget': [
    {
      q: 'How many pieces should be in a teen capsule wardrobe?',
      a: 'A practical school capsule wardrobe consists of 15 to 20 interchangeable pieces, including 4 tops, 3 bottoms, 2 layerings, 2 pairs of footwear, and versatile accessories.'
    },
    {
      q: 'How do I choose colors for a capsule wardrobe?',
      a: 'Stick to a 3-color palette: two neutral foundation shades (like black, white, cream, or navy) and one soft accent color (like sage, blush, or baby blue).'
    }
  ],
  'small-bedroom-ideas-for-teens-on-a-budget': [
    {
      q: 'How can I make a small teen bedroom look bigger?',
      a: 'Use vertical wall space with pegboards, mount floating shelves, stick to light neutral bedding, and use warm ambient lighting instead of harsh overhead lamps.'
    }
  ]
};

const activeFaqs = faqsBySlug[post.slug];
const faqSchema = activeFaqs && activeFaqs.length > 0 ? {
  '@type': 'FAQPage',
  '@id': `${postUrl}#faq`,
  mainEntity: activeFaqs.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
} : null;

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${postUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Magazine', item: `${SITE_URL}/edits` },
    { '@type': 'ListItem', position: 3, name: categoryLabel, item: absoluteUrl(categoryUrl) },
    { '@type': 'ListItem', position: 4, name: post.title }
  ]
};
---

<BaseLayout
  title={`${post.title} | TeenTimeGlow`}
  description={post.excerpt}
  ogImage={coverImage}
  ogType="article"
  schema={[articleSchema, breadcrumbSchema, ...(howToSchema ? [howToSchema] : []), ...(faqSchema ? [faqSchema] : [])]}
>
  <!-- Reading Progress Bar -->
  <div class="reading-progress-track">
    <div class="reading-progress-fill" id="readingProgress"></div>
  </div>

  <main class="article-reader-container">
    <!-- Breadcrumb & Back Bar -->
    <div class="container breadcrumb-wrap">
      <nav class="breadcrumb-nav">
        <a href="/" class="breadcrumb-link">Home</a>
        <span class="breadcrumb-sep">/</span>
        <a href="/edits" class="breadcrumb-link">Magazine</a>
        <span class="breadcrumb-sep">/</span>
        <a href={categoryUrl} class="breadcrumb-link">{categoryLabel}</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">{post.title}</span>
      </nav>
      <a href="/edits" class="btn-back-home magnetic-btn">
        <span>← Back to Magazine</span>
      </a>
    </div>

    <!-- Article Header -->
    <article class="article-main-wrap">
      <header class="article-header container">
        <div class="article-meta-top">
          <span class="article-cat-badge">
            <a href={categoryUrl} style="color:inherit;text-decoration:none">{categoryLabel}</a>
          </span>
          <span class="article-read-time">📖 {post.read_time_minutes} min read</span>
          <span class="article-date-pill">✦ ISSUE #28</span>
          <span class="article-verified-badge" title="Fact-checked against current dermatological and peer-reviewed research">
            <span class="badge-check">✓</span> Fact-Checked & Reviewed on {new Date(post.updated_at || post.created_at || '2026-10-26').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
          </span>
        </div>

        <h1 class="article-hero-title">{post.title}</h1>
        <p class="article-lead-excerpt">{post.excerpt}</p>

        <!-- Author Byline Bar -->
        <div class="author-byline-bar">
          <div class="author-info-left">
            <img src="/assets/logo.jpg" alt="Rini" class="author-avatar-img" />
            <div class="author-text-col">
              <span class="author-name">Rini</span>
              <span class="author-role">Founder & Lifestyle Curator • TeenTimeGlow</span>
            </div>
          </div>

          <div class="social-share-row">
            <button class="btn-share-icon" onclick="copyArticleLink(event)" title="Copy Article Link">
              <span>🔗</span>
            </button>
            <button class="btn-share-icon" onclick="shareOnTwitter(event)" title="Share on Twitter">
              <span>🐦</span>
            </button>
            <button class="btn-share-icon" onclick="shareOnPinterest(event)" title="Pin to Moodboard">
              <span>📌</span>
            </button>
          </div>
        </div>
      </header>

      <!-- Full-Bleed Cover Image -->
      <div class="container cover-banner-container">
        <div class="article-cover-frame">
          <img
            src={post.cover_image_url}
            alt={post.title}
            class="article-cover-img parallax-img"
          />
        </div>
      </div>

      <!-- Main Content Layout (Sidebar + Rich Body) -->
      <div class="container article-body-layout">
        <!-- Sticky Left Sidebar -->
        <aside class="article-sidebar">
          <div class="sidebar-sticky-box">
            <span class="sidebar-heading">✦ IN THIS EDIT</span>
            <ul class="sidebar-toc-list">
              {toc.length > 0 ? (
                toc.map((item, i) => (
                  <li>
                    <a href={`#${item.id}`} class="toc-link">
                      <span class="toc-bullet">{String(i + 1).padStart(2, '0')}</span>
                      {item.text}
                    </a>
                  </li>
                ))
              ) : (
                <li><span class="toc-bullet">01</span> Read the full edit</li>
              )}
            </ul>

            <div class="sidebar-divider"></div>

            <div class="sidebar-moodboard-card">
              <span class="moodboard-pill">♡ AESTHETIC VIBE</span>
              <p class="moodboard-text">"Protect your peace, romanticize small moments, and let your natural glow speak for itself."</p>
            </div>
          </div>
        </aside>

        <!-- Article Rich HTML Body -->
        <div class="article-rich-body">
          <div class="rich-html-content" set:html={articleHtml} />

          {post.category === 'skincare' && (
            <div class="scientific-references-box">
              <div class="refs-header">
                <span class="refs-icon">🔬</span>
                <h4>Scientific Evidence & Clinical References</h4>
              </div>
              <p class="refs-intro">
                TeenTimeGlow is committed to evidence-based skincare guidance. Recommendations for barrier-repair ingredients are grounded in peer-reviewed dermatological literature:
              </p>
              <ul class="refs-list">
                <li>
                  <strong>Centella Asiatica (Madecassoside):</strong> Bylka W, et al. <em>"Centella asiatica in cosmetology."</em> Postepy Dermatol Alergol. 2013 Feb;30(1):46-9.
                  <a href="https://pubmed.ncbi.nlm.nih.gov/23620842/" target="_blank" rel="noopener noreferrer" class="ref-link">PubMed PMID: 23620842 ↗</a>
                </li>
                <li>
                  <strong>Niacinamide (Vitamin B3) Barrier Recovery:</strong> Bissett DL, et al. <em>"Niacinamide: A B vitamin that improves aging facial skin appearance and barrier function."</em> Dermatol Surg. 2005 Jul;31(7 Pt 2):860-5.
                  <a href="https://pubmed.ncbi.nlm.nih.gov/16029679/" target="_blank" rel="noopener noreferrer" class="ref-link">PubMed PMID: 16029679 ↗</a>
                </li>
                <li>
                  <strong>Ceramides & Transepidermal Water Loss:</strong> Coderch L, et al. <em>"Ceramides and skin function."</em> Am J Clin Dermatol. 2003;4(2):107-29.
                  <a href="https://pubmed.ncbi.nlm.nih.gov/12553851/" target="_blank" rel="noopener noreferrer" class="ref-link">PubMed PMID: 12553851 ↗</a>
                </li>
              </ul>
            </div>
          )}

          <!-- Author Signature Card -->
          <div class="author-signoff-card">
            <img src="/assets/logo.jpg" alt="Rini" class="signoff-avatar" />
            <div class="signoff-text">
              <h4>Curated with love by Rini</h4>
              <p>Every edit is crafted to bring effortless elegance, peace of mind, and radiant aesthetic inspiration to your daily rituals.</p>
              <a href="/edits" class="btn-explore-more">Explore More Edits &rarr;</a>
            </div>
          </div>
        </div>
      </div>
    </article>

    <!-- Related Articles Carousel / Grid -->
    {relatedPosts.length > 0 && (
      <section class="related-edits-section">
        <div class="container">
          <div class="related-header">
            <span class="section-pill-tag">✦ KEEP READING</span>
            <h2 class="related-title">You Might Also Love</h2>
          </div>

          <div class="related-grid">
            {relatedPosts.map((rel) => (
              <a href={`/edits/${rel.slug}`} class="related-card tilt-card">
                <div class="related-thumb-wrap">
                  <img src={rel.cover_image_url} alt={rel.title} class="related-thumb-img" loading="lazy" />
                  <span class="related-cat-badge">{categoryByDbValue(rel.category)?.label || rel.category}</span>
                </div>
                <div class="related-info">
                  <h3 class="related-card-title">{rel.title}</h3>
                  <span class="related-read-more">Read Edit &rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<script is:inline>
  // Reading Progress Bar
  window.addEventListener('scroll', () => {
    const docEl = document.documentElement;
    const scrollTop = docEl.scrollTop || document.body.scrollTop;
    const scrollHeight = docEl.scrollHeight - docEl.clientHeight;
    const progress = (scrollTop / (scrollHeight || 1)) * 100;
    const fillEl = document.getElementById('readingProgress');
    if (fillEl) fillEl.style.width = `${Math.min(progress, 100)}%`;
  });

  function copyArticleLink(e) {
    e.preventDefault();
    navigator.clipboard.writeText(window.location.href).then(() => {
      if (typeof window.playTone === 'function') window.playTone(600, 'sine', 0.15);
      if (typeof window.showToast === 'function') {
        window.showToast('Article link copied to clipboard! 🔗');
      }
    });
  }

  function shareOnTwitter(e) {
    e.preventDefault();
    const url = encodeURIComponent(window.location.href);
    const text = encodeURIComponent(document.title);
    window.open(`https://twitter.com/intent/tweet?url=${url}&text=${text}`, '_blank');
  }

  function shareOnPinterest(e) {
    e.preventDefault();
    const url = encodeURIComponent(window.location.href);
    const desc = encodeURIComponent(document.title);
    window.open(`https://pinterest.com/pin/create/button/?url=${url}&description=${desc}`, '_blank');
  }
</script>

<style>
  /* ==========================================================================
     Dynamic Article Reader Styles
     ========================================================================== */
  .reading-progress-track {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: transparent;
    z-index: 999999;
  }
  .reading-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #E85D04 0%, #FAA307 100%);
    transition: width 0.1s ease-out;
  }

  .article-reader-container {
    padding-top: 100px;
    padding-bottom: 80px;
    background: #FAF7F2;
    min-height: 100vh;
  }

  /* Breadcrumb */
  .breadcrumb-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    margin-bottom: 24px;
  }
  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    font-weight: 600;
  }
  .breadcrumb-link {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .breadcrumb-link:hover {
    color: var(--sunset-accent);
  }
  .breadcrumb-sep {
    color: #CBD5E1;
  }
  .breadcrumb-current {
    color: #111827;
    max-width: 320px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .btn-back-home {
    font-size: 0.84rem;
    font-weight: 700;
    color: #111827;
    text-decoration: none;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    padding: 8px 16px;
    border-radius: 999px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    transition: all 0.2s ease;
  }
  .btn-back-home:hover {
    border-color: var(--sunset-accent);
    color: var(--sunset-accent);
    transform: translateX(-2px);
  }

  /* Article Header */
  .article-header {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
    padding: 30px 20px 40px;
  }
  .article-meta-top {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .article-verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(16, 185, 129, 0.08);
    color: #065F46;
    border: 1px solid rgba(16, 185, 129, 0.2);
    font-size: 0.76rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 999px;
    letter-spacing: 0.02em;
  }
  .article-verified-badge .badge-check {
    color: #059669;
    font-weight: 900;
  }
  .article-cat-badge {
    background: rgba(232, 93, 4, 0.08);
    color: var(--sunset-accent);
    font-size: 0.78rem;
    font-weight: 800;
    padding: 4px 12px;
    border-radius: 999px;
    letter-spacing: 0.04em;
  }
  .article-read-time, .article-date-pill {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .article-hero-title {
    font-family: var(--font-editorial);
    font-size: clamp(2.2rem, 4.5vw, 3.8rem);
    line-height: 1.15;
    color: #0F1115;
    margin-bottom: 20px;
    font-weight: 700;
  }
  .article-lead-excerpt {
    font-family: var(--font-editorial);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-style: italic;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 32px;
  }

  /* Author Byline Bar */
  .author-byline-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
  }
  .author-info-left {
    display: flex;
    align-items: center;
    gap: 12px;
    text-align: left;
  }
  .author-avatar-img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--sunset-accent);
  }
  .author-text-col {
    display: flex;
    flex-direction: column;
  }
  .author-name {
    font-weight: 800;
    font-size: 0.95rem;
    color: #111827;
  }
  .author-role {
    font-size: 0.76rem;
    color: var(--text-muted);
  }
  .social-share-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .btn-share-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #FAF9F6;
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }
  .btn-share-icon:hover {
    background: var(--sunset-accent);
    color: #FFFFFF;
    border-color: var(--sunset-accent);
  }

  /* Full Bleed Cover */
  .cover-banner-container {
    max-width: 1040px;
    margin: 20px auto 40px;
  }
  .article-cover-frame {
    aspect-ratio: 16 / 9;
    border-radius: 28px;
    overflow: hidden;
    background: #111827;
    box-shadow: 0 20px 45px rgba(0,0,0,0.1);
  }
  .article-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Article Body Layout */
  .article-body-layout {
    max-width: 1040px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 50px;
  }

  /* Sidebar */
  .sidebar-sticky-box {
    position: sticky;
    top: 120px;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
  }
  .sidebar-heading {
    font-size: 0.76rem;
    font-weight: 800;
    color: var(--sunset-accent);
