---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts } from '@/lib/api';
import { CATEGORIES, SITE_URL, absoluteUrl } from '@/config/seo';
import type { Post } from '@/types/database';

export const prerender = false;

// Hydrate live posts with fallback seeds
const posts: Post[] = await getPosts();

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);

const categoryLabels: Record<string, string> = {
  beauty: 'Beauty & Skincare',
  fashion: 'Fashion Lookbook',
  decor: 'Cozy Decor'
};

const beautyCount = posts.filter(p => p.category === 'beauty').length;
const fashionCount = posts.filter(p => p.category === 'fashion').length;
const decorCount = posts.filter(p => p.category === 'decor').length;

const editsUrl = absoluteUrl('/edits');
const editsSchema = {
  '@type': 'CollectionPage',
  '@id': `${editsUrl}#collection`,
  url: editsUrl,
  name: 'Editorial Magazine — TeenTimeGlow',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  inLanguage: 'en',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.slice(0, 20).map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: absoluteUrl(`/edits/${p.slug}`),
      name: p.title
    }))
  }
};
---

<BaseLayout
  title="Editorial Magazine & Lookbooks — TeenTimeGlow by Rini"
  description="Explore curated teen fashion lookbooks, Korean glass skincare rituals, and cozy bedroom aesthetic decor guides by Rini. High-fashion inspiration for everyday life."
  schema={[editsSchema]}
>
  <main class="edits-page-container">
    <!-- Breadcrumb & Back Bar -->
    <div class="container breadcrumb-wrap">
      <nav class="breadcrumb-nav">
        <a href="/" class="breadcrumb-link">Home</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">Editorial Magazine</span>
      </nav>
      <a href="/" class="btn-back-home magnetic-btn">
        <span>← Back to Main Magazine</span>
      </a>
    </div>

    <!-- Hero Header -->
    <section class="edits-hero">
      <div class="container text-center">
        <div class="hero-badge-wrap">
          <span class="section-pill-tag">✦ DIGITAL LIFESTYLE MAGAZINE</span>
          <span class="hero-live-badge">ISSUE #28 • GOLDEN HOUR</span>
        </div>
        <h1 class="edits-hero-title">Curated Edits & Lookbooks.<br /><span class="glow-gradient-text">Glow From Within.</span></h1>
        <p class="edits-hero-subtitle">
          Deep-dive guides on dewy glass skincare rituals, effortless autumn layering formulas, and cozy bedroom aesthetics curated by Rini.
        </p>
      </div>
    </section>

    <!-- Category hub links: crawlable entry points into each topical cluster.
         The filter tabs below are JS-only, so Google needs real anchors. -->
    <nav class="container cat-hub-strip" aria-label="Browse by category">
      {CATEGORIES.map((c) => (
        <a href={`/edits/category/${c.slug}`} class="cat-hub-link">
          <span class="cat-hub-label">{c.label}</span>
          <span class="cat-hub-count">
            {c.dbValue === 'beauty' ? beautyCount : c.dbValue === 'fashion' ? fashionCount : decorCount} guides
          </span>
        </a>
      ))}
    </nav>

    <!-- Featured Cover Story Spotlight Banner -->
    {featuredPost && (
      <section class="cover-story-section">
        <div class="container">
          <a href={`/edits/${featuredPost.slug}`} class="cover-story-card tilt-card">
            <div class="cover-story-img-wrap">
              <img
                src={featuredPost.cover_image_url}
                alt={featuredPost.title}
                class="cover-story-img"
                loading="lazy"
              />
              <span class="cover-story-badge">✦ FEATURED COVER STORY</span>
            </div>
            <div class="cover-story-info">
              <div class="cover-meta-row">
                <span class="cover-cat-pill">{categoryLabels[featuredPost.category] || featuredPost.category}</span>
                <span class="cover-read-time">📖 {featuredPost.read_time_minutes} min read</span>
              </div>
              <h2 class="cover-story-title">{featuredPost.title}</h2>
              <p class="cover-story-excerpt">{featuredPost.excerpt}</p>
              <div class="cover-cta-row">
                <span class="btn-read-cover">Read Full Cover Story &rarr;</span>
              </div>
            </div>
          </a>
        </div>
      </section>
    )}

    <!-- Toolbar & Filter Tabs -->
    <section class="edits-toolbar-section">
      <div class="container">
        <div class="toolbar-box">
          <!-- Search Input -->
          <div class="search-input-wrap">
            <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="editsSearchInput"
              class="search-input-field"
              placeholder="Search lookbooks, skincare routines, decor..."
              oninput="handleEditsSearch(this.value)"
            />
          </div>

          <!-- Category Filter Tabs -->
          <div class="filter-tabs-wrap">
            <button class="edit-filter-tab active" data-category="all" onclick="filterEditsPage('all', this)">
              All Stories ({posts.length})
            </button>
            <button class="edit-filter-tab" data-category="beauty" onclick="filterEditsPage('beauty', this)">
              ✨ Beauty & Glow ({beautyCount})
            </button>
            <button class="edit-filter-tab" data-category="fashion" onclick="filterEditsPage('fashion', this)">
              👗 Fashion Lookbooks ({fashionCount})
            </button>
            <button class="edit-filter-tab" data-category="decor" onclick="filterEditsPage('decor', this)">
              ☕ Cozy Spaces ({decorCount})
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Magazine Grid Section -->
    <section class="edits-grid-section">
      <div class="container">
        {posts.length === 0 && (
          <div class="no-results-state" style="display: block;">
            <div class="no-results-icon">📖</div>
            <h3>No edits published yet</h3>
            <p>The first story is being written. New lookbooks, skincare guides and room makeovers land here every week.</p>
            <a href="/wallpapers" class="btn-reset-filters" style="display:inline-block;text-decoration:none;">Browse wallpapers instead</a>
          </div>
        )}

        <div class="edits-catalog-grid" id="editsGrid">
          {posts.map((post) => (
            <a
              href={`/edits/${post.slug}`}
              class="edit-catalog-card tilt-card"
              data-category={post.category}
              data-title={post.title.toLowerCase()}
              data-excerpt={post.excerpt.toLowerCase()}
            >
              <div class="catalog-thumb-wrap">
                <img
                  src={post.cover_image_url}
                  alt={post.title}
                  class="catalog-thumb-img parallax-img"
                  loading="lazy"
                  decoding="async"
                />
                <span class="catalog-cat-pill">{categoryLabels[post.category] || post.category}</span>
                <span class="catalog-time-pill">{post.read_time_minutes} min read</span>
              </div>
              <div class="catalog-card-details">
                <div class="catalog-stars-row">
                  <span class="stars">★★★★★</span>
                  <span class="author-label">Curated by Rini</span>
                </div>
                <h3 class="catalog-card-title">{post.title}</h3>
                <p class="catalog-card-excerpt">{post.excerpt}</p>
                <div class="catalog-card-footer">
                  <span class="btn-read-text">Read Article &rarr;</span>
                </div>
              </div>
            </a>
          ))}
        </div>

        <!-- No Results Fallback -->
        <div id="noEditsFound" class="no-results-state" style="display: none;">
          <div class="no-results-icon">📖</div>
          <h3>No articles match your search</h3>
          <p>Try searching for a different keyword or reset your category filters.</p>
          <button class="btn-reset-filters" onclick="resetEditsFilters()">Show All Stories</button>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  function filterEditsPage(category, btn) {
    document.querySelectorAll('.edit-filter-tab').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');

    const cards = document.querySelectorAll('#editsGrid .edit-catalog-card');
    let visibleCount = 0;

    cards.forEach(card => {
      const cardCategory = card.getAttribute('data-category');
      const matches = category === 'all' || cardCategory === category;
      if (matches) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    const empty = document.getElementById('noEditsFound');
    if (empty) empty.style.display = visibleCount === 0 ? 'block' : 'none';
  }

  function handleEditsSearch(term) {
    const q = term.toLowerCase().trim();
    const cards = document.querySelectorAll('#editsGrid .edit-catalog-card');
    let visibleCount = 0;

    cards.forEach(card => {
      const title = card.getAttribute('data-title') || '';
      const excerpt = card.getAttribute('data-excerpt') || '';
      const matches = !q || title.includes(q) || excerpt.includes(q);
      if (matches) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    const empty = document.getElementById('noEditsFound');
    if (empty) empty.style.display = visibleCount === 0 ? 'block' : 'none';
  }

  function resetEditsFilters() {
    const input = document.getElementById('editsSearchInput');
    if (input) input.value = '';
    const allBtn = document.querySelector('.edit-filter-tab[data-category="all"]');
    filterEditsPage('all', allBtn);
  }
</script>

<style>
  /* ==========================================================================
     Dedicated Magazine Index Styles
     ========================================================================== */
  .edits-page-container {
    padding-top: 100px;
    padding-bottom: 80px;
    background: #FAF7F2;
    min-height: 100vh;
  }

  /* Breadcrumb */
  .breadcrumb-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    margin-bottom: 24px;
  }
  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    font-weight: 600;
  }
  .breadcrumb-link {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .breadcrumb-link:hover {
    color: var(--sunset-accent);
  }
  .breadcrumb-sep {
    color: #CBD5E1;
  }
  .breadcrumb-current {
    color: #111827;
  }
  .btn-back-home {
    font-size: 0.84rem;
    font-weight: 700;
    color: #111827;
    text-decoration: none;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    padding: 8px 16px;
    border-radius: 999px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    transition: all 0.2s ease;
  }
  .btn-back-home:hover {
    border-color: var(--sunset-accent);
    color: var(--sunset-accent);
    transform: translateX(-2px);
  }

  /* Category hub strip */
  .cat-hub-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 8px auto 4px;
  }
  .cat-hub-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 20px;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .cat-hub-link:hover {
    border-color: var(--sunset-accent);
    transform: translateY(-2px);
  }
  .cat-hub-label {
    font-weight: 800;
    font-size: 0.9rem;
    color: #111827;
  }
  .cat-hub-count {
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  /* Hero Section */
  .edits-hero {
    padding: 40px 0 30px;
  }
  .hero-badge-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 16px;
  }
  .hero-live-badge {
    background: #E85D04;
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 999px;
    letter-spacing: 0.05em;
  }
  .edits-hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    line-height: 1.05;
    color: #0F1115;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }
  .glow-gradient-text {
    background: linear-gradient(135deg, #E85D04 0%, #FAA307 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .edits-hero-subtitle {
    font-size: 1.08rem;
    color: var(--text-muted);
    max-width: 640px;
    margin: 0 auto 10px;
    line-height: 1.6;
  }

  /* Cover Story Spotlight */
  .cover-story-section {
    padding: 24px 0 40px;
  }
  .cover-story-card {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: 28px;
    overflow: hidden;
    text-decoration: none;
    box-shadow: 0 16px 40px -10px rgba(232, 93, 4, 0.08);
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .cover-story-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 50px rgba(232, 93, 4, 0.16);
  }
  .cover-story-img-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #111827;
  }
  .cover-story-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .cover-story-card:hover .cover-story-img {
    transform: scale(1.05);
  }
  .cover-story-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background: linear-gradient(135deg, #E85D04 0%, #FAA307 100%);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 6px 14px;
    border-radius: 999px;
    letter-spacing: 0.05em;
  }
  .cover-story-info {
    padding: 44px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .cover-meta-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .cover-cat-pill {
    background: rgba(232, 93, 4, 0.08);
    color: var(--sunset-accent);
    font-size: 0.76rem;
    font-weight: 800;
    padding: 4px 12px;
    border-radius: 999px;
  }
  .cover-read-time {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .cover-story-title {
    font-family: var(--font-editorial);
    font-size: clamp(1.6rem, 2.8vw, 2.3rem);
    color: #0F1115;
    line-height: 1.25;
    margin-bottom: 14px;
  }
  .cover-story-excerpt {
    font-size: 0.96rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 24px;
  }
  .btn-read-cover {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--sunset-accent);
    font-weight: 800;
    font-size: 0.95rem;
    transition: gap 0.2s;
  }
  .cover-story-card:hover .btn-read-cover {
    gap: 14px;
  }

  /* Toolbar Section */
  .edits-toolbar-section {
    padding: 20px 0;
  }
  .toolbar-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    padding: 14px 20px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
  }
  .search-input-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #FAF9F6;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 10px 18px;
    flex: 1;
    min-width: 280px;
    max-width: 440px;
  }
  .search-input-wrap:focus-within {
    border-color: var(--sunset-accent);
    background: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(232, 93, 4, 0.12);
  }
  .search-icon {
    color: var(--text-muted);
  }
  .search-input-field {
    border: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: 0.92rem;
    color: #111827;
    outline: none;
    width: 100%;
  }
  .filter-tabs-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .edit-filter-tab {
    background: #FAF9F6;
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 0.86rem;
    font-weight: 700;
    padding: 8px 18px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .edit-filter-tab:hover {
    color: #111827;
    background: #F3F4F6;
  }
  .edit-filter-tab.active {
    background: #0C3B2E;
    color: #FFFFFF;
    border-color: #0C3B2E;
  }

  /* Catalog Grid */
  .edits-grid-section {
    padding: 20px 0 60px;
  }
  .edits-catalog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .edit-catalog-card {
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 18px rgba(0,0,0,0.03);
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .edit-catalog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(232, 93, 4, 0.12);
    border-color: rgba(232, 93, 4, 0.3);
  }
  .catalog-thumb-wrap {
    position: relative;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: #111827;
  }
  .catalog-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .edit-catalog-card:hover .catalog-thumb-img {
    transform: scale(1.08);
  }
  .catalog-cat-pill {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(8px);
    color: #FFFFFF;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: 0.04em;
  }
  .catalog-time-pill {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    color: #111827;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 6px;
  }
  .catalog-card-details {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 10px;
  }
  .catalog-stars-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.78rem;
    color: #E85D04;
    font-weight: 700;
  }
  .author-label {
    color: var(--text-muted);
  }
  .catalog-card-title {
    font-family: var(--font-editorial);
    font-size: 1.25rem;
    color: #111827;
    line-height: 1.35;
    font-weight: 700;
  }
  .catalog-card-excerpt {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
    flex: 1;
  }
  .catalog-card-footer {
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
  }
  .btn-read-text {
    font-size: 0.86rem;
    font-weight: 800;
    color: var(--sunset-accent);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: gap 0.2s;
  }
  .edit-catalog-card:hover .btn-read-text {
    gap: 10px;
  }

  /* No Results */
  .no-results-state {
    text-align: center;
    padding: 60px 20px;
    background: #FFFFFF;
    border-radius: 20px;
    border: 1px dashed var(--border-subtle);
  }
  .no-results-icon {
    font-size: 3rem;
    margin-bottom: 12px;
  }
  .btn-reset-filters {
    margin-top: 16px;
    background: var(--sunset-accent);
    color: #FFFFFF;
    border: none;
    font-weight: 700;
    padding: 10px 22px;
    border-radius: 999px;
    cursor: pointer;
  }

  @media (max-width: 960px) {
    .cover-story-card {
      grid-template-columns: 1fr;
    }
    .edits-catalog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .toolbar-box {
      flex-direction: column;
      align-items: stretch;
    }
    .search-input-wrap {
      max-width: 100%;
    }
  }
  @media (max-width: 600px) {
    .edits-catalog-grid {
      grid-template-columns: 1fr;
    }
    .cover-story-info {
      padding: 24px;
    }
  }
</style>
