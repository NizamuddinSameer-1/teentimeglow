---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import StatsStrip from '@/components/StatsStrip.astro';
import EditsSection from '@/components/EditsSection.astro';
import RankingsSection from '@/components/RankingsSection.astro';
import QuotesSection from '@/components/QuotesSection.astro';
import WallpapersSection from '@/components/WallpapersSection.astro';
import QuizSection from '@/components/QuizSection.astro';
import GallerySection from '@/components/GallerySection.astro';

import {
  getPosts,
  getRankings,
  getQuotes,
  getWallpapers,
  getCommunityCreations,
  getSiteSettings
} from '@/lib/api';

// Hydrate dynamically from Supabase (with instant seed fallback)
const [posts, rankings, quotes, wallpapers, creations, settings] = await Promise.all([
  getPosts(),
  getRankings(),
  getQuotes(),
  getWallpapers(),
  getCommunityCreations(),
  getSiteSettings()
]);

const customStats = settings ? [
  { target: settings.readersCount || '14850', suffix: '+', label: '✨ Radiant Readers' },
  { target: settings.satisfactionRate || '99.4', suffix: '%', decimals: '1', label: '★ Glow Satisfaction' },
  { target: '100', suffix: '%', label: '📱 Free 4K Wallpaper Vault' },
  { target: '365', suffix: ' Days', label: '☕ Curated Teen Inspo' }
] : undefined;
---
<BaseLayout>
  <Hero
    issueBadge={settings?.heroBadge}
    headline={settings?.heroHeading}
    subtext={settings?.heroSubtext}
  />
  <StatsStrip stats={customStats} />
  <EditsSection posts={posts} />
  <RankingsSection rankings={rankings} />
  <QuotesSection quotes={quotes} />
  <WallpapersSection wallpapers={wallpapers} />
  <QuizSection />
  <GallerySection creations={creations} />
</BaseLayout>
