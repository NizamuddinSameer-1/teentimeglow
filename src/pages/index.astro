---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import StatsStrip from '@/components/StatsStrip.astro';
import EditsSection from '@/components/EditsSection.astro';
import RankingsSection from '@/components/RankingsSection.astro';
import QuotesSection from '@/components/QuotesSection.astro';
import WallpapersSection from '@/components/WallpapersSection.astro';
import QuizSection from '@/components/QuizSection.astro';
import GallerySection from '@/components/GallerySection.astro';

import {
  getPosts,
  getRankings,
  getQuotes,
  getWallpapers,
  getCommunityCreations,
  getSiteSettings
} from '@/lib/api';

// Hydrate dynamically from Supabase (with instant seed fallback)
const [posts, rankings, quotes, wallpapers, creations, settings] = await Promise.all([
  getPosts(),
  getRankings(),
  getQuotes(),
  getWallpapers(),
  getCommunityCreations(),
  getSiteSettings()
]);

/**
 * Homepage counters.
 *
 * Every figure below is computed from live data at request time. Nothing is
 * hardcoded. The previous version displayed invented social proof — "14,850+
 * readers" and "99.4% glow satisfaction" were literals in the source, not
 * measurements — which is a trust problem on a site aimed at teenagers and a
 * deceptive-practices risk under Google's spam policies.
 *
 * If a counter reads low, that is the honest number and the fix is to earn it,
 * not to type a bigger one.
 */
const totalDownloads = wallpapers.reduce((sum, w) => sum + (w.download_count || 0), 0);

const liveStats = [
  { target: String(posts.length), suffix: '', label: '✦ Guides Published' },
  { target: String(wallpapers.length), suffix: '', label: '📱 Free Wallpapers' },
  { target: String(totalDownloads), suffix: '', label: '⬇ Wallpaper Downloads' },
  { target: String(creations.length), suffix: '', label: '💅 Community Creations' }
  // A counter sitting at zero reads as a broken site rather than an empty one.
  // Omitting it isn't a false claim — it just isn't displayed until it's true.
].filter((stat) => Number(stat.target) > 0);
---
<BaseLayout>
  <Hero
    issueBadge={settings?.heroBadge}
    headline={settings?.heroHeading}
    subtext={settings?.heroSubtext}
  />
  <StatsStrip stats={liveStats} />
  <EditsSection posts={posts} />
  <RankingsSection rankings={rankings} />
  <QuotesSection quotes={quotes} />
  <WallpapersSection wallpapers={wallpapers} />
  <QuizSection />
  <GallerySection creations={creations} />
</BaseLayout>
