  }
  .mood-tabs-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }
  .mood-tab-btn {
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 0.86rem;
    font-weight: 700;
    padding: 8px 18px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .mood-tab-btn:hover {
    color: #111827;
    background: #FAF9F6;
  }
  .mood-tab-btn.active {
    background: #0C3B2E;
    color: #FFFFFF;
    border-color: #0C3B2E;
  }

  /* Quotes Grid */
  .quotes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .quote-grid-card {
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    padding: 28px 24px;
    display: flex;
