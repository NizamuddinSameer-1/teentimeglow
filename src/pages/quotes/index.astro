  }
  .btn-quote-main:hover {
    background: var(--sunset-accent);
    transform: translateY(-2px);
  }
  .btn-quote-secondary {
    background: #FAF9F6;
    border: 1px solid var(--border-subtle);
    color: #111827;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 12px 20px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
