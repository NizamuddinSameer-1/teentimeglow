    letter-spacing: 0.04em;
  }
  .card-heart-tag {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 600;
  }
  .card-quote-mark {
    font-family: var(--font-editorial);
    font-size: 2.4rem;
    line-height: 1;
    color: rgba(232, 93, 4, 0.3);
    margin-bottom: -8px;
  }
  .card-quote-text {
    font-family: var(--font-editorial);
    font-size: 1.08rem;
    font-style: italic;
    color: #111827;
    line-height: 1.5;
    margin-bottom: 20px;
  }
  .card-bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
  }
  .card-author-lbl {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-muted);
  }
  .card-permalink {
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .card-permalink:hover {
    color: var(--sunset-accent);
  }
