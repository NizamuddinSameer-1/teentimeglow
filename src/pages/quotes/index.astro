  }
  .btn-quote-secondary:hover {
    background: #FFFFFF;
    border-color: var(--sunset-accent);
    color: var(--sunset-accent);
  }
  .btn-icon {
    font-size: 1.1rem;
  }

  /* Quotes Archive Section */
  .quotes-archive-section {
    padding: 40px 0 60px;
  }
  .archive-header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .archive-title {
    font-family: var(--font-editorial);
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    color: #0F1115;
    margin-top: 6px;
  }
  .quotes-search-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 10px 18px;
    min-width: 280px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
  }
  .quote-search-field {
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: #111827;
