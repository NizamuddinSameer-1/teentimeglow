---
// Visual Rich-Text Editor for Rini (Zero HTML, Zero Markdown required)
interface Props {
  initialContent?: string;
  placeholder?: string;
}

const {
  initialContent = '',
  placeholder = 'Write your aesthetic article, skincare routine steps, or outfit styling tips here...'
} = Astro.props;
---

<div class="rich-editor-wrapper">
  <!-- Top Formatting Toolbar -->
  <div class="rich-toolbar">
    <!-- Group 1: Typography -->
    <div class="toolbar-group">
      <button type="button" class="toolbar-btn" data-command="formatBlock" data-val="h2" title="Section Heading (H2)">
        <strong>H2</strong>
      </button>
      <button type="button" class="toolbar-btn" data-command="formatBlock" data-val="h3" title="Sub-Heading (H3)">
        <strong>H3</strong>
      </button>
      <button type="button" class="toolbar-btn" data-command="formatBlock" data-val="p" title="Normal Paragraph">
        Paragraph
      </button>
    </div>

    <div class="toolbar-divider"></div>

    <!-- Group 2: Inline Styles -->
    <div class="toolbar-group">
      <button type="button" class="toolbar-btn" data-command="bold" title="Bold Text (Ctrl+B)">
        <strong>B</strong>
      </button>
      <button type="button" class="toolbar-btn" data-command="italic" title="Italic Text (Ctrl+I)">
        <em>I</em>
      </button>
      <button type="button" class="toolbar-btn" data-command="formatBlock" data-val="blockquote" title="Quote Callout Block">
        ❝ Quote
      </button>
      <button type="button" class="toolbar-btn" data-command="insertUnorderedList" title="Bullet List">
        • Bullet List
      </button>
    </div>

    <div class="toolbar-divider"></div>

    <!-- Group 3: Alignment & Dividers -->
    <div class="toolbar-group">
      <button type="button" class="toolbar-btn" data-command="justifyLeft" title="Align Left">
        ⇤ Left
      </button>
      <button type="button" class="toolbar-btn" data-command="justifyCenter" title="Align Center">
        ↔ Center
      </button>
      <button type="button" class="toolbar-btn" onclick="insertDivider()" title="Insert Horizontal Divider">
        ― Divider
      </button>
    </div>

    <div class="toolbar-divider"></div>

    <!-- Group 4: Affiliate Links & Media Insertions -->
    <div class="toolbar-group">
      <button type="button" class="toolbar-btn affiliate-btn" onclick="openAffiliateLinkModal()" title="Insert Affiliate Link or Hyperlink">
        🔗 Affiliate Link
      </button>
      <label class="toolbar-btn photo-btn" title="Add a photo right where your cursor is">
        📸 Insert Photo
        <input type="file" id="inlinePhotoInput" accept="image/*" style="display: none;" onchange="handleInlinePhotoUpload(event)" />
      </label>
      <span id="photoUploadStatus" class="photo-upload-spinner" style="display: none;">Uploading... ⏳</span>
      <button type="button" class="toolbar-btn" data-command="removeFormat" title="Clear Formatting">
        ✕ Clear
      </button>
    </div>
  </div>

  <!-- Contenteditable Visual Canvas -->
  <div
    id="visualEditorCanvas"
    class="editor-canvas"
    contenteditable="true"
    data-placeholder={placeholder}
    set:html={initialContent}
  ></div>

  <!-- Hidden input for form sync -->
  <input type="hidden" id="richEditorOutput" name="content_html" value={initialContent} />

  <!-- Floating Affiliate Hyperlink Modal -->
  <div id="affiliateLinkModal" class="link-modal-overlay" style="display: none;">
    <div class="link-modal-card">
      <div class="link-modal-header">
        <div style="font-weight: 800; font-size: 1rem; color: #0F1115; display: flex; align-items: center; gap: 6px;">
          <span>🔗</span> Insert Link / Affiliate Link
        </div>
        <button type="button" class="btn-close-link-modal" onclick="closeAffiliateLinkModal()">✕</button>
      </div>

      <div class="link-modal-body">
        <div class="modal-form-group">
          <label class="modal-label">Link Destination URL *</label>
          <input
            type="url"
            id="affiliateUrlInput"
            placeholder="https://amzn.to/3... or https://brand.com/product"
            class="modal-input"
          />
          <div style="font-size: 0.72rem; color: #6B7280; margin-top: 3px;">Paste your full link or affiliate tracking link here.</div>
        </div>

        <div class="modal-form-group">
          <label class="modal-label">Display Anchor Text *</label>
          <input
            type="text"
            id="affiliateTextInput"
            placeholder="e.g. Shop the Glazed Lip Oil Here"
            class="modal-input"
          />
        </div>

        <div class="modal-checkbox-row">
          <input type="checkbox" id="affiliateSponsoredCheck" checked />
          <label for="affiliateSponsoredCheck" class="checkbox-label">
            Mark as Affiliate / Sponsored Link (<code class="badge-code">rel="sponsored noopener"</code>)
          </label>
        </div>

        <div class="modal-footer-actions">
          <button type="button" class="btn-modal-cancel" onclick="closeAffiliateLinkModal()">Cancel</button>
          <button type="button" class="btn-modal-insert" onclick="insertAffiliateLink()">Insert Link ✨</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .rich-editor-wrapper {
    background: #FFFFFF;
    border: 1.5px solid #E5E7EB;
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    transition: all 0.2s ease;
  }

  .rich-editor-wrapper:focus-within {
    border-color: var(--sunset-accent);
    box-shadow: 0 0 0 3px rgba(232, 93, 4, 0.12);
  }

  .rich-toolbar {
    background: #FAF7F2;
    border-bottom: 1px solid #E5E7EB;
    padding: 8px 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .toolbar-group {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .toolbar-divider {
    width: 1px;
    height: 20px;
    background: #D1D5DB;
    margin: 0 4px;
  }

  .toolbar-btn {
    background: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 0.85rem;
    font-weight: 700;
    color: #374151;
    cursor: pointer;
    transition: all 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    user-select: none;
  }

  .toolbar-btn:hover {
    background: #F3F4F6;
    border-color: #9CA3AF;
    color: #111827;
  }

  .toolbar-btn:active {
    background: #E5E7EB;
    transform: scale(0.98);
  }

  .affiliate-btn {
    background: rgba(200, 82, 58, 0.08);
    border-color: rgba(200, 82, 58, 0.3);
    color: #C8523A;
  }

  .affiliate-btn:hover {
    background: rgba(200, 82, 58, 0.16);
    border-color: #C8523A;
    color: #C8523A;
  }

  .photo-btn {
    background: rgba(232, 93, 4, 0.08);
    border-color: rgba(232, 93, 4, 0.3);
    color: var(--sunset-accent);
  }

  .photo-btn:hover {
    background: rgba(232, 93, 4, 0.15);
    border-color: var(--sunset-accent);
    color: var(--sunset-accent);
  }

  .photo-upload-spinner {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--sunset-accent);
    padding: 2px 6px;
    background: rgba(232, 93, 4, 0.1);
    border-radius: 6px;
    animation: pulse 1.2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .editor-canvas {
    min-height: 260px;
    max-height: 550px;
    overflow-y: auto;
    padding: 20px;
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.7;
    color: #1F2937;
    outline: none;
  }

  .editor-canvas:empty:before {
    content: attr(data-placeholder);
    color: #9CA3AF;
    pointer-events: none;
    display: block;
  }

  .editor-canvas h2 {
    font-family: var(--font-editorial);
    font-size: 1.5rem;
    font-weight: 700;
    color: #0F1115;
    margin: 18px 0 8px 0;
  }

  .editor-canvas h3 {
    font-size: 1.22rem;
    font-weight: 700;
    color: #1F2937;
    margin: 14px 0 6px 0;
  }

  .editor-canvas p {
    margin: 0 0 12px 0;
  }

  .editor-canvas blockquote {
    border-left: 3px solid var(--sunset-accent);
    background: rgba(232, 93, 4, 0.05);
    margin: 16px 0;
    padding: 12px 18px;
    font-style: italic;
    color: #374151;
    border-radius: 0 8px 8px 0;
  }

  .editor-canvas ul {
    margin: 8px 0 16px 20px;
  }

  .editor-canvas img,
  .editor-canvas .article-body-photo {
    max-width: 100%;
    border-radius: 12px;
    margin: 16px 0;
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    display: block;
  }

  .editor-canvas a.editorial-affiliate-link,
  .editorial-affiliate-link {
    color: var(--sunset-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .editor-canvas a.editorial-affiliate-link::after,
  .editorial-affiliate-link::after {
    content: '↗';
    font-size: 0.75em;
    opacity: 0.7;
  }

  .editor-canvas hr.editorial-divider,
  .editorial-divider {
    border: none;
    border-top: 2px dashed #E5E7EB;
    margin: 24px 0;
  }

  /* Link Modal Overlay inside Editor */
  .link-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 17, 21, 0.45);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    padding: 16px;
  }

  .link-modal-card {
    background: #FFFFFF;
    border-radius: 16px;
    width: 100%;
    max-width: 440px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    overflow: hidden;
    animation: modalPop 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modalPop {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }

  .link-modal-header {
    padding: 14px 18px;
    border-bottom: 1px solid #E5E7EB;
    background: #FAF7F2;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .btn-close-link-modal {
    background: none;
    border: none;
    font-size: 1.1rem;
    color: #6B7280;
    cursor: pointer;
    padding: 4px;
    border-radius: 6px;
  }

  .btn-close-link-modal:hover {
    color: #111827;
    background: #E5E7EB;
  }

  .link-modal-body {
    padding: 18px;
  }

  .modal-form-group {
    margin-bottom: 14px;
  }

  .modal-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: #374151;
    display: block;
    margin-bottom: 5px;
  }

  .modal-input {
    width: 100%;
    box-sizing: border-box;
    padding: 9px 12px;
    border: 1.5px solid #D1D5DB;
    border-radius: 8px;
    font-size: 0.9rem;
    font-family: inherit;
    outline: none;
    transition: all 0.2s;
  }

  .modal-input:focus {
    border-color: var(--sunset-accent);
    box-shadow: 0 0 0 3px rgba(232, 93, 4, 0.1);
  }

  .modal-checkbox-row {
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .checkbox-label {
    font-size: 0.84rem;
    color: #374151;
    font-weight: 600;
    cursor: pointer;
  }

  .badge-code {
    font-size: 0.75rem;
    background: #F3F4F6;
    padding: 2px 5px;
    border-radius: 4px;
    color: #4B5563;
  }

  .modal-footer-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }

  .btn-modal-cancel {
    background: #F3F4F6;
    border: 1px solid #D1D5DB;
    color: #4B5563;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
  }

  .btn-modal-cancel:hover {
    background: #E5E7EB;
  }

  .btn-modal-insert {
    background: var(--sunset-accent);
    border: none;
    color: #FFFFFF;
    padding: 8px 18px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(232, 93, 4, 0.25);
    transition: all 0.15s;
  }

  .btn-modal-insert:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }
</style>

<script is:inline>
  // Global selection range cache for robust in-between insertions
  window.savedEditorSelectionRange = null;

  function initRichEditor() {
    const toolbar = document.querySelector('.rich-toolbar');
    const canvas = document.getElementById('visualEditorCanvas');
    const output = document.getElementById('richEditorOutput');

    if (!toolbar || !canvas || !output) return;

    // Track caret position whenever user interacts with canvas
    function updateCaret() {
      const sel = window.getSelection();
      if (sel && sel.rangeCount > 0) {
        const range = sel.getRangeAt(0);
        if (canvas.contains(range.commonAncestorContainer)) {
          window.savedEditorSelectionRange = range.cloneRange();
        }
      }
    }

    canvas.addEventListener('keyup', updateCaret);
    canvas.addEventListener('mouseup', updateCaret);
    canvas.addEventListener('touchend', updateCaret);
    canvas.addEventListener('click', updateCaret);

    // Standard command buttons (bold, h2, list, align)
    toolbar.querySelectorAll('button[data-command]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const cmd = btn.getAttribute('data-command');
        const val = btn.getAttribute('data-val') || null;
        canvas.focus();
        if (window.savedEditorSelectionRange) {
          const sel = window.getSelection();
          sel.removeAllRanges();
          sel.addRange(window.savedEditorSelectionRange);
        }
        document.execCommand(cmd, false, val);
        updateCaret();
        syncOutput();
      });
    });

    // Content sync
    canvas.addEventListener('input', () => {
      updateCaret();
      syncOutput();
    });
    canvas.addEventListener('blur', syncOutput);

    function syncOutput() {
      if (output) output.value = canvas.innerHTML;
    }

    // Expose helpers globally
    window.setRichEditorContent = function(html) {
      if (canvas) canvas.innerHTML = html || '';
      if (output) output.value = html || '';
    };

    window.getRichEditorContent = function() {
      return canvas ? canvas.innerHTML : '';
    };

    // Store caret immediately when file input is triggered
    const photoInput = document.getElementById('inlinePhotoInput');
    if (photoInput) {
      photoInput.addEventListener('click', updateCaret);
    }
  }

  // Horizontal Divider insertion
  function insertDivider() {
    const canvas = document.getElementById('visualEditorCanvas');
    const output = document.getElementById('richEditorOutput');
    if (!canvas) return;

    canvas.focus();
    const hr = document.createElement('hr');
    hr.className = 'editorial-divider';

    const p = document.createElement('p');
    p.innerHTML = '<br>';

    const sel = window.getSelection();
    let inserted = false;

    if (window.savedEditorSelectionRange && canvas.contains(window.savedEditorSelectionRange.commonAncestorContainer)) {
      try {
        sel.removeAllRanges();
        sel.addRange(window.savedEditorSelectionRange);
        window.savedEditorSelectionRange.deleteContents();
        window.savedEditorSelectionRange.insertNode(p);
        window.savedEditorSelectionRange.insertNode(hr);
        inserted = true;
      } catch (err) {
        console.warn('Range insertion error for divider:', err);
      }
    }

    if (!inserted) {
      canvas.appendChild(hr);
      canvas.appendChild(p);
    }

    const newRange = document.createRange();
    newRange.setStart(p, 0);
    newRange.collapse(true);
    sel.removeAllRanges();
    sel.addRange(newRange);
    window.savedEditorSelectionRange = newRange.cloneRange();

    if (output) output.value = canvas.innerHTML;
  }

  // Affiliate Link Modal controls
  function openAffiliateLinkModal() {
    const canvas = document.getElementById('visualEditorCanvas');
    const modal = document.getElementById('affiliateLinkModal');
    const urlInput = document.getElementById('affiliateUrlInput');
    const textInput = document.getElementById('affiliateTextInput');

    // Capture range
    const sel = window.getSelection();
    if (sel && sel.rangeCount > 0) {
      const range = sel.getRangeAt(0);
      if (canvas && canvas.contains(range.commonAncestorContainer)) {
        window.savedEditorSelectionRange = range.cloneRange();
        if (!range.collapsed) {
          textInput.value = range.toString();
        } else {
          textInput.value = '';
        }
      }
    }

    urlInput.value = '';
    modal.style.display = 'flex';
    setTimeout(() => urlInput.focus(), 50);
  }

  function closeAffiliateLinkModal() {
    const modal = document.getElementById('affiliateLinkModal');
    if (modal) modal.style.display = 'none';
  }

  function insertAffiliateLink() {
    const canvas = document.getElementById('visualEditorCanvas');
    const output = document.getElementById('richEditorOutput');
    const urlInput = document.getElementById('affiliateUrlInput');
    const textInput = document.getElementById('affiliateTextInput');
    const sponsoredCheck = document.getElementById('affiliateSponsoredCheck');

    let rawUrl = (urlInput.value || '').trim();
    if (!rawUrl) {
      alert('Please enter a destination URL');
      return;
    }
    if (!rawUrl.startsWith('http://') && !rawUrl.startsWith('https://')) {
      rawUrl = 'https://' + rawUrl;
    }

    const linkText = (textInput.value || '').trim() || rawUrl;
    const isSponsored = sponsoredCheck ? sponsoredCheck.checked : true;
    const rel = isSponsored ? 'sponsored noopener' : 'noopener noreferrer';

    canvas.focus();
    const a = document.createElement('a');
    a.href = rawUrl;
    a.target = '_blank';
    a.rel = rel;
    a.className = 'editorial-affiliate-link';
    a.textContent = linkText;

    const sel = window.getSelection();
    let inserted = false;

    if (window.savedEditorSelectionRange && canvas.contains(window.savedEditorSelectionRange.commonAncestorContainer)) {
      try {
        sel.removeAllRanges();
        sel.addRange(window.savedEditorSelectionRange);
        window.savedEditorSelectionRange.deleteContents();
        window.savedEditorSelectionRange.insertNode(a);
        inserted = true;
      } catch (err) {
        console.warn('Range insertion error for link:', err);
      }
    }

    if (!inserted) {
      canvas.appendChild(a);
    }

    // Insert trailing space so user can keep typing text without it becoming part of link
    const space = document.createTextNode(' ');
    if (a.nextSibling) {
      a.parentNode.insertBefore(space, a.nextSibling);
    } else {
      a.parentNode.appendChild(space);
    }

    const newRange = document.createRange();
    newRange.setStartAfter(space);
    newRange.collapse(true);
    sel.removeAllRanges();
    sel.addRange(newRange);
    window.savedEditorSelectionRange = newRange.cloneRange();

    if (output) output.value = canvas.innerHTML;
    closeAffiliateLinkModal();
  }

  // Handle inline image upload inside article body at exact cursor position
  async function handleInlinePhotoUpload(event) {
    const file = event.target.files?.[0];
    if (!file) return;

    const statusEl = document.getElementById('photoUploadStatus');
    if (statusEl) statusEl.style.display = 'inline';

    try {
      const formData = new FormData();
      formData.append('file', file);

      const res = await fetch('/api/admin/upload', {
        method: 'POST',
        body: formData
      });
      const contentType = res.headers.get('content-type') || '';
      const data = contentType.includes('application/json')
        ? await res.json()
        : { success: false, error: (await res.text()) || `Upload error (${res.status})` };

      if (data.success && data.url) {
        const canvas = document.getElementById('visualEditorCanvas');
        const output = document.getElementById('richEditorOutput');
        if (!canvas) return;

        canvas.focus();

        const img = document.createElement('img');
        img.src = data.url;
        img.alt = 'Article illustration';
        img.className = 'article-body-photo';
        img.style.maxWidth = '100%';
        img.style.borderRadius = '12px';
        img.style.margin = '16px 0';
        img.style.display = 'block';

        const pSpacer = document.createElement('p');
        pSpacer.innerHTML = '<br>';

        const sel = window.getSelection();
        let inserted = false;

        if (window.savedEditorSelectionRange && canvas.contains(window.savedEditorSelectionRange.commonAncestorContainer)) {
          try {
            sel.removeAllRanges();
            sel.addRange(window.savedEditorSelectionRange);
            window.savedEditorSelectionRange.deleteContents();
            window.savedEditorSelectionRange.insertNode(pSpacer);
            window.savedEditorSelectionRange.insertNode(img);
            inserted = true;
          } catch (e) {
            console.warn('Range insertion error for photo, falling back to append:', e);
          }
        }

        if (!inserted) {
          canvas.appendChild(img);
          canvas.appendChild(pSpacer);
        }

        const newRange = document.createRange();
        newRange.setStart(pSpacer, 0);
        newRange.collapse(true);
        sel.removeAllRanges();
        sel.addRange(newRange);
        window.savedEditorSelectionRange = newRange.cloneRange();

        if (output) output.value = canvas.innerHTML;
      } else {
        alert('Could not upload photo: ' + (data.error || 'Unknown error'));
      }
    } catch (err) {
      alert('Photo upload failed: ' + err.message);
    } finally {
      if (statusEl) statusEl.style.display = 'none';
      event.target.value = '';
    }
  }

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRichEditor);
  } else {
    initRichEditor();
  }
</script>
