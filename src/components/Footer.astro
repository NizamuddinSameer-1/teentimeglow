---
import { siteContent } from '@/config/siteContent';

interface Props {
  logoText?: string;
  headline?: string;
  description?: string;
  mascotCaption?: string;
  copyright?: string;
}

const {
  logoText = siteContent.footer.logoText,
  headline = siteContent.footer.headline,
  description = siteContent.footer.description,
  mascotCaption = siteContent.footer.mascotCaption,
  copyright = siteContent.footer.copyright
} = Astro.props;
---
<footer id="newsletter">
  <div class="container">
    <div class="footer-layout">
      <!-- Left: Newsletter & Socials -->
      <div class="footer-left">
        <div class="footer-arched-logo">{logoText}</div>
        <h3 class="footer-offer-title">{headline}</h3>
        <p class="footer-offer-desc">{description}</p>
        
        <form class="newsletter-form" onsubmit="handleNewsletter(event)">
          <input type="email" id="newsletterEmail" placeholder="your email address..." class="newsletter-input" aria-label="Your email address" required />
          <button type="submit" class="newsletter-btn" aria-label="Subscribe">&gt;</button>
        </form>

        <div class="social-row">
          {siteContent.footer.socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="social-circle-btn" title={s.name}>{s.icon}</a>
          ))}
        </div>
      </div>

      <!-- Center: Aesthetic Iced Tumbler Mascot -->
      <div class="footer-center">
        <img src="/assets/footer-jar.jpg" alt="TeenTimeGlow Iced Jar Mascot" class="footer-jar-img" id="mascotJar" loading="lazy" decoding="async" />
        <p class="footer-mascot-caption">{mascotCaption}</p>
      </div>

      <!-- Right: Link Columns -->
      <div class="footer-right">
        <div>
          <h4 class="footer-col-title">Features & Edits</h4>
          <ul class="footer-links">
            <li><a href="/edits">Editorial Lookbooks & Edits</a></li>
            <li><a href="/rankings">Prime Video & Audiobooks</a></li>
            <li><a href="/wallpapers">Free 4K Wallpapers Vault</a></li>
            <li><a href="/quotes">Daily Mindset & Quotes</a></li>
            <li><a href="/quiz">Aesthetic Glow Quiz</a></li>
            <li><a href="/gallery">Community Showcase Drops</a></li>
          </ul>
        </div>

        <div>
          <h4 class="footer-col-title">TeenTimeGlow</h4>
          <ul class="footer-links">
            <li><a href="#" onclick="openStoryModal('about')">About Rini</a></li>
            <li><a href="/quiz">The Glow Quiz ✨</a></li>
            <li><a href="/quotes">Daily Teen Mindset 🌸</a></li>
            <li><a href="/gallery">Community Showcase 💅</a></li>
            <li><a href="#" onclick="openSubmitModal()">Submit Your Work</a></li>
            <li><a href="/admin">Admin Login 🔒</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <div>{copyright}</div>
      <div style="display: flex; gap: 20px;">
        <a href="#" onclick="showToast('Privacy Policy: We never sell your personal data.')">Privacy Policy</a>
        <a href="#" onclick="showToast('Terms: Content is for aesthetic inspiration.')">Terms of Service</a>
        <a href="#" onclick="showToast('Community Guidelines: Be kind, radiant & supportive.')">Community Guidelines</a>
      </div>
    </div>
  </div>
</footer>
