---
import type { Ranking } from '@/types/database';
import { siteContent } from '@/config/siteContent';

interface Props {
  rankings: Ranking[];
  tag?: string;
  title?: string;
  subtitle?: string;
  ctaText?: string;
}

const {
  rankings,
  tag = siteContent.rankings.tag,
  title = siteContent.rankings.title,
  subtitle = siteContent.rankings.subtitle,
  ctaText = siteContent.rankings.ctaText
} = Astro.props;
---
<section class="section-block" id="rankings">
  <div class="container">
    <div class="section-header reveal-header">
      <div class="section-title-wrap">
        <span class="section-pill-tag">{tag}</span>
        <h2 class="section-title split-title">{title}</h2>
        <p class="section-subtitle">{subtitle}</p>
      </div>
      <a href="/rankings" class="quiz-pill-btn magnetic-btn">{ctaText}</a>
    </div>

    <div class="rankings-grid">
      {rankings.map((item) => {
        const isAudiobook = item.category === 'audiobook';
        const typeBadge = isAudiobook ? `#${item.rank_order} AUDIOBOOK` : `#${item.rank_order} TOP SERIES`;
        const typeTag = isAudiobook ? 'Audible • ' + (item.tags[0] || 'Audiobook') : 'Prime Video • ' + (item.tags[0] || 'Drama');
        return (
          <div class="ranking-card tilt-card">
            <div class="ranking-poster-frame">
              <img src={item.cover_image_url} alt={item.title} class="ranking-poster-img parallax-img" loading="lazy" decoding="async" />
              <span class="ranking-badge-top">{typeBadge}</span>
              <span class="ranking-type-tag">{typeTag}</span>
            </div>
            <div class="ranking-details">
              <h3 class="ranking-title">{item.title}</h3>
              <p class="ranking-synopsis">{item.review_text}</p>
              <div class="ranking-footer-row">
                <span class="stars">★★★★★ {item.rating.toFixed(1)}</span>
                {isAudiobook ? (
                  <button onclick={`playAudiobookPreview('${item.title}', event)`} class="ranking-action-link" style="background: none; border: none; cursor: pointer;">Listen Sample ♫</button>
                ) : (
                  <a href={item.watch_url || 'https://www.amazon.com/primevideo'} target="_blank" rel="noopener noreferrer" class="ranking-action-link">Watch on Prime ↗</a>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <div style="text-align: center; margin-top: 40px;">
      <a href="/rankings" class="btn-black-pill magnetic-btn">
        <span>View Full Leaderboards & Reviews →</span>
      </a>
    </div>
  </div>
</section>
